(let $hit_concat_virtual_terminal (Descend "b" (ConcatZ (IntersectionZ (TrieZ $seps) (TrieZ $seps)) (TrieZ $sb))))
(let $hit_prefix (Descend "b" (Descend "a" (PrefixZipper $pa (TrieZ $sb)))))
(let $hit_unwrap (Descend "b" (UnwrapZ (TrieZ $sab) $pa)))
(let $hit_nonempty (Descend "b" (Descend "a" (NonEmptyZ (TrieZ $sab)))))
(let $hit_tails_union (Descend "b" (TailsUnionZ (TrieZ $src_ac))))
(let $hit_tails_intersection (Descend "b" (TailsIntersectionZ (TrieZ (Union $sab $sab)))))
