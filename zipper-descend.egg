(let $miss_trie (Descend "c" (Descend "a" (TrieZ $sab))))
(let $miss_memo (Descend "c" (Descend "a" (MemoZ (TrieZ $sab)))))
(let $miss_union (Descend "d" (Descend "a" (UnionZ (TrieZ $sab) (TrieZ $sac)))))
(let $miss_join (Descend "d" (Descend "a" (JoinAllZ3 (TrieZ $sab) (TrieZ $sac) (TrieZ (Empty))))))
