(let $miss_meetall (Descend "c" (Descend "a" (MeetAllZ3 (TrieZ $src_ac) (TrieZ $sab) (TrieZ $sab)))))
(let $miss_subtraction (Descend "b" (Descend "a" (SubtractionZ (TrieZ $src_ac) (TrieZ $sab)))))
