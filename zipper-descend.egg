  (UnionOp (TrieZ $src_ac) (IterOp (FixpointOp (TrieZ $src_ac) (HeadTemplate)) (HeadTemplate)))))
(check (fixpoint-unfold-result $fixpoint_unfold_reconstruct
  (UnionOp (TrieZ $src_ac) (IterOp (FixpointOp (TrieZ $src_ac) (ReconstructTemplate)) (ReconstructTemplate)))))
(check (fixpoint-unfold-result $fixpoint_unfold_prefixed_reconstruct_empty
  (UnionOp (TrieZ $src_ac) (IterOp (FixpointOp (TrieZ $src_ac) (PrefixedReconstructTemplate (Eps))) (PrefixedReconstructTemplate (Eps))))))
(check (fixpoint-unfold-result $fixpoint_unfold_range_tail_full
  (UnionOp (TrieZ $szq) (IterOp (FixpointOp (TrieZ $szq) (RangeTailTemplate "0" "0")) (RangeTailTemplate "0" "0")))))
(check (fixpoint-unfold-result $fixpoint_unfold_range_tail_empty
  (UnionOp (TrieZ $szq) (IterOp (FixpointOp (TrieZ $szq) (RangeTailTemplate "1" "1")) (RangeTailTemplate "1" "1")))))
(check (fixpoint-unfold-result $fixpoint_unfold_range_reconstruct
  (UnionOp (TrieZ $src_ac) (IterOp (FixpointOp (TrieZ $src_ac) (RangeReconstructTemplate "0" "1")) (RangeReconstructTemplate "0" "1")))))
(check (fixpoint-unfold-result $fixpoint_unfold_prefixed_range_reconstruct_empty
  (UnionOp (TrieZ $src_ac) (IterOp (FixpointOp (TrieZ $src_ac) (PrefixedRangeReconstructTemplate (Eps) "0" "1")) (PrefixedRangeReconstructTemplate (Eps) "0" "1")))))

; Non-acceptance: misses must not contain terminal/eof acceptance.
(fail (check (terminal $miss_trie)))
(fail (check (terminal $miss_memo)))
(fail (check (terminal $miss_union)))
(fail (check (terminal $miss_join)))
(fail (check (terminal $miss_intersection)))
(fail (check (terminal $miss_meetall)))
(fail (check (terminal $miss_subtraction)))
(fail (check (terminal $miss_restriction_prefix)))
(fail (check (terminal $miss_restriction_epsilon)))
(fail (check (terminal $miss_raffination)))
(fail (check (terminal $miss_concat)))
(fail (check (terminal $miss_prefix)))
(fail (check (terminal $miss_unwrap)))
(fail (check (terminal $miss_nonempty)))
(fail (check (terminal $miss_tails_union)))
(fail (check (terminal $miss_tails_intersection)))
(fail (check (terminal $miss_head)))
(fail (check (terminal $miss_iter_range_tail_same_head_first_later)))
(fail (check (terminal $miss_iter_range_tail_same_head_drop_last_later)))
(fail (check (terminal $miss_iter_range_reconstruct_same_head_first_later)))
(fail (check (terminal $miss_iter_range_reconstruct_same_head_drop_last_later)))
(fail (check (terminal $miss_iter_prefixed_range_reconstruct_same_head_drop_last_later)))
(fail (check (terminal $miss_fixpoint_reconstruct_added_head)))
(fail (check (terminal $miss_range_single_after_end)))
(fail (check (terminal $miss_range_single_drop_last)))
(fail (check (terminal $miss_range_single_negative_window)))
(fail (check (terminal $miss_range_last_border_wrong_child)))
(fail (check (terminal $miss_range_drop_last_prunes_last_head)))
(fail (check (terminal $miss_range_negative_window_prunes_last_head)))
(fail (check (terminal $miss_range_first_no_epsilon_prunes_later_head)))
(fail (check (terminal $miss_range_virtual_first_prunes_later_head)))
(fail (check (terminal $miss_range_virtual_drop_last_prunes_later_head)))
(fail (check (terminal $miss_range_virtual_cd_first_prunes_later_head)))
(fail (check (terminal $miss_range_virtual_cd_drop_last_prunes_later_head)))

; Exact key checks for implementation scheduling.
(check (has-key $keys_union "a"))
(check (has-key $keys_union "b"))
(check (has-key $keys_intersection "a"))
(fail (check (has-key $keys_intersection "b")))
(check (has-key $keys_subtraction "a"))
(fail (check (has-key $keys_subtraction "b")))
(check (has-key $keys_restriction_prefix "a"))
(fail (check (has-key $keys_restriction_prefix "b")))
(check (has-key $keys_restriction_epsilon "a"))
(fail (check (has-key $keys_restriction_epsilon "b")))
(check (has-key $keys_concat_terminal "b"))
(fail (check (has-key $keys_concat_terminal "a")))

; Exact positive key analysis: subtraction can keep a left schedule key when a
; residual child remains, but it must not report the removed identical child.
(check (has-key $exact_keys_subtraction_kept "a"))
(fail (check (has-key $exact_keys_subtraction_kept "b")))
(fail (check (has-key $exact_keys_subtraction_removed "a")))
(check (nonempty-focus $exact_keys_subtraction_kept))
(fail (check (nonempty-focus $exact_keys_subtraction_removed)))

; Context/plug witnesses: the focus plus its sibling context reconstructs the
; expected whole shape.  Exhaustive path-observation checks for plug live in
; ZipperDenotationOracleTest, where the concrete context zipper is executable.
(check (plugged $ctx_a_with_d (TrieZ $sb) $plug_ab_with_d_impl))
(check (plugged $ctx_terminal_a (EmptyZ) $plug_terminal_without_child_impl))
(check (terminal $plug_terminal_without_child_observed))
(check (down-move (RootCtx) $virtual_context_parent "a" $virtual_context_child_ctx_a $virtual_context_child_a))
(check (up-move $virtual_context_child_ctx_a $virtual_context_child_a (RootCtx) $virtual_context_up_a))
(check (plugged $virtual_context_child_ctx_a $virtual_context_child_a $virtual_context_up_a))
(check (terminal (Descend "b" $virtual_context_child_a)))
(check (context-path (RootCtx) (Eps)))
(check (context-path $virtual_context_child_ctx_a $pa))
(check (cursor-path (RootCtx) $virtual_context_parent (Eps)))
(check (cursor-path $virtual_context_child_ctx_a $virtual_context_child_a $pa))
(fail (check (cursor-path $virtual_context_child_ctx_a $virtual_context_child_a $pb)))
(check (next-sibling-move $sibling_ctx_a $sibling_child_a $sibling_next_ctx_b $sibling_next_focus_b))
(check (previous-sibling-move $sibling_next_ctx_b $sibling_next_focus_b $sibling_previous_ctx_a $sibling_previous_focus_a))
(check (plugged $sibling_next_ctx_b $sibling_next_focus_b $sibling_updated_after_b))
(check (terminal $sibling_next_focus_b))
(check (terminal $sibling_previous_focus_a))
(check (context-path $sibling_next_ctx_b $pb))
(check (context-path $sibling_previous_ctx_a $pa))
(fail (check (next-sibling-move $sibling_next_ctx_b $sibling_next_focus_b $sibling_ctx_a $sibling_child_a)))

; The key-set lattice must not collapse through over-approximate schedules.
(fail (check (= (KEmpty) (KOne "a"))))
(fail (check (= (KOne "a") (KOne "b"))))
