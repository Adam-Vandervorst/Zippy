; SMT-LIB twin of least_fixpoint_unique.p — two least solutions of X = a u F(X) coincide
; (in the join-semilattice ordering leq(X,Y) := X u Y = Y).
(declare-sort L 0)
(declare-fun cup (L L) L)
(declare-fun leq (L L) Bool)
(declare-fun f (L) L)
(declare-const a L)
(declare-const l1 L)
(declare-const l2 L)
(assert (forall ((x L)) (= (cup x x) x)))
(assert (forall ((x L) (y L)) (= (cup x y) (cup y x))))
(assert (forall ((x L) (y L) (z L)) (= (cup (cup x y) z) (cup x (cup y z)))))
(assert (forall ((x L) (y L)) (= (leq x y) (= (cup x y) y))))
(assert (= l1 (cup a (f l1))))
(assert (= l2 (cup a (f l2))))
(assert (forall ((z L)) (=> (= z (cup a (f z))) (leq l1 z))))
(assert (forall ((z L)) (=> (= z (cup a (f z))) (leq l2 z))))
(assert (not (= l1 l2)))
(check-sat)
