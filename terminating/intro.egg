(datatype Path
  (Eps)
  (Item String)
  (Concat Path Path))

(datatype Space
  (Empty)
  (LitEmpty)
  (Mention String)
  (Static String)
  (Singleton Path)
  (Union Space Space)
  (Intersection Space Space)
  (Subtraction Space Space)
  (Restriction Space Space)
  (Wrap Path Space)
  (Unwrap Space Path)
  (Product Space Space)
  (Head Space)
  (Range Space String String)
  (Iter Space Space)
  (TailsUnion Space)
  (TailsIntersection Space)
  (PrefixClosure Space)
  (SuffixClosure Space)
  (TailsClosure Space)
  (Fixpoint Space String Space))

(datatype ZPos
  (AtRoot)
  (InPrefix String ZPos)
  (BeyondPrefix String ZPos)
  (AtSource))

(datatype Zipper
  (Descend String Zipper)
  (TrieZ Space)
  (EmptyZ)
  (UnionZ Zipper Zipper)
  (IntersectionZ Zipper Zipper)
  (SubtractionZ Zipper Zipper)
  (RestrictionZ Zipper Zipper)
  (ConcatZ Zipper Zipper)
  (PrefixZipper Path ZPos Zipper)
  (UnwrapZ Zipper Path)
  (TailsUnionZ Zipper)
  (TailsIntersectionZ Zipper)
  (PrefixClosureZ Zipper)
  (SuffixClosureZ Zipper)
  (TailsClosureZ Zipper)
  (RangeZ Zipper String String))

(relation materializes (Zipper Space))

; Zipper movement model: these rewrites are local in the current focus. They do
; not inspect whole subtries; materialization is the catamorphism that eventually
; asks for children.
(rewrite (Descend item (TrieZ (Wrap (Item item) s))) (TrieZ s))
(rewrite (Descend item (TrieZ (Union (Wrap (Item item) s) t))) (UnionZ (TrieZ s) (Descend item (TrieZ t))))
(rewrite (Descend item (UnionZ a b)) (UnionZ (Descend item a) (Descend item b)))
(rewrite (Descend item (IntersectionZ a b)) (IntersectionZ (Descend item a) (Descend item b)))
(rewrite (Descend item (SubtractionZ a b)) (SubtractionZ (Descend item a) (Descend item b)))
(rewrite (Descend item (RestrictionZ a b)) (RestrictionZ (Descend item a) (Descend item b)))
(rewrite (Descend item (PrefixZipper (Item item) (InPrefix item p) s))
         (PrefixZipper (Eps) (BeyondPrefix item p) s))
(rewrite (Descend item (PrefixZipper (Concat (Item item) rest) (InPrefix item p) s))
         (PrefixZipper rest (BeyondPrefix item p) s))
(rewrite (Descend item (PrefixZipper (Eps) (AtSource) s)) (Descend item s))
(rewrite (Descend item (UnwrapZ s (Item item))) s)
(rewrite (Descend item (UnwrapZ s (Concat (Item item) rest))) (UnwrapZ s rest))
(rewrite (Descend item (PrefixClosureZ s)) (PrefixClosureZ (Descend item s)))
(rewrite (Descend item (SuffixClosureZ s)) (UnionZ (Descend item s)
                                                   (Descend item (TailsUnionZ (SuffixClosureZ s)))))
(rewrite (Descend item (TailsClosureZ s)) (Descend item (SuffixClosureZ s)))
(rule ((= z (TrieZ s)))
      ((materializes z s)))
(rule ((= z (UnionZ a b)) (materializes a sa) (materializes b sb))
      ((materializes z (Union sa sb))))
(rule ((= z (IntersectionZ a b)) (materializes a sa) (materializes b sb))
      ((materializes z (Intersection sa sb))))
(rule ((= z (SubtractionZ a b)) (materializes a sa) (materializes b sb))
      ((materializes z (Subtraction sa sb))))
(rule ((= z (RestrictionZ a b)) (materializes a sa) (materializes b sb))
      ((materializes z (Restriction sa sb))))
(rule ((= z (ConcatZ a b)) (materializes a sa) (materializes b sb))
      ((materializes z (Product sa sb))))

(relation drop-prefix (Path Path Space))
(relation tails-intersection (Space Space Space))
(relation tails-intersection-acc (Space Space Space Space))

; expr1 = a | b
(let expr1 (Union (Singleton (Item "a")) (Singleton (Item "b"))))
; expr2 = i x (a | b)
(let expr2 (Wrap (Item "i") expr1))
; expr3 = (ia | ib)
(let expr3 (Union (Singleton (Concat (Item "i") (Item "a"))) (Singleton (Concat (Item "i") (Item "b")))))
; expr4 = (ia | ib)(i)
(let expr4 (Unwrap expr3 (Item "i")))
(let expr_qi (Concat (Item "q") (Item "i")))
(let expr_qi_unwrap (Unwrap (Wrap expr_qi expr1) expr_qi))
(let expr_unwrap_prefix (Unwrap (Singleton (Concat (Item "a") (Item "b"))) (Item "a")))
(let expr_unwrap_exact (Unwrap (Singleton (Concat (Item "a") (Item "b"))) (Concat (Item "a") (Item "b"))))
(let expr_unwrap_miss (Unwrap (Singleton (Item "a")) (Item "b")))
(let expr1_ (Union (Singleton (Item "x")) (Singleton (Item "y"))))
(let expr_prod (Product expr1_ expr1))
(let expr_prod_expanded (Union (Union (Singleton (Concat (Item "x") (Item "a")))
                                      (Singleton (Concat (Item "x") (Item "b"))))
                               (Union (Singleton (Concat (Item "y") (Item "a")))
                                      (Singleton (Concat (Item "y") (Item "b"))))))
(let expr_tailsunion1 (TailsUnion expr_prod_expanded))
(let expr_tailsintersection1 (TailsIntersection expr_prod_expanded))
(let expr1_head (Head expr1))
(let expr3_head (Head expr3))
(let expr_prod_head (Head expr_prod_expanded))
;test("intersection all") {
;  val keys =
;    (s("a", "b") x ss"0") \/
;    (s("a", "c", "d") x ss"1") \/
;    (s("c") x ss"2")
;
;  assert(eval(/\(keys <| s("a", "b"))).prettyLines == "0")
;}
(let expr_s0 (Singleton (Item "0")))
(let expr_restriction_keys
  (Union
    (Union
      (Product expr1 (Singleton (Item "0")))
      (Product (Union (Singleton (Item "a")) (Union (Singleton (Item "c")) (Singleton (Item "d")))) (Singleton (Item "1"))))
    (Product (Singleton (Item "c")) (Singleton (Item "2")))))
(let expr_restriction (Restriction expr_restriction_keys expr1))
(let expr_restriction_tailsintersection (TailsIntersection expr_restriction))
(let expr_restriction_res1
  (Union (Union (Singleton (Concat (Item "a") (Item "0")))
                (Singleton (Concat (Item "a") (Item "1"))))
         (Singleton (Concat (Item "b") (Item "0")))))
(let expr_restriction_multi
  (Restriction
    (Union (Wrap (Item "a") (Singleton (Item "0")))
           (Wrap (Item "b") (Singleton (Item "1"))))
    (Union (Singleton (Item "a")) (Singleton (Item "b")))))
(let expr_restriction_multi_res
  (Union (Singleton (Concat (Item "a") (Item "0")))
         (Singleton (Concat (Item "b") (Item "1")))))
(let expr_restriction_multi_only_a
  (Singleton (Concat (Item "a") (Item "0"))))

(let expr_tailsintersection_duplicate_heads
  (TailsIntersection
    (Union
      (Union (Wrap (Item "a") (Singleton (Item "0")))
             (Wrap (Item "a") (Singleton (Item "1"))))
      (Wrap (Item "b") (Singleton (Item "0"))))))



(let expr_empty_literal (LitEmpty))
(let expr_range_identity (Range expr_prod_expanded "0" "0"))
(let expr_range_union_absorb (Union expr_prod_expanded (Range expr_prod_expanded "0" "2")))
(let expr_range_intersection_absorb (Intersection expr_prod_expanded (Range expr_prod_expanded "0" "2")))
(let expr_range_sub_empty (Subtraction (Range expr_prod_expanded "0" "2") expr_prod_expanded))
(let expr_range_nested_01 (Range (Range expr_prod_expanded "0" "2") "0" "1"))
(let expr_range_nested_12 (Range (Range expr_prod_expanded "0" "4") "2" "3"))
(let expr_range_nested_empty (Range (Range expr_prod_expanded "0" "2") "2" "2"))
(let expr_prefix_empty (PrefixClosure (Empty)))
(let expr_suffix_empty (SuffixClosure (Empty)))
(let expr_tails_empty (TailsClosure (Empty)))
(let expr_prefix_idempotent (PrefixClosure (PrefixClosure expr_prod_expanded)))
(let expr_suffix_idempotent (SuffixClosure (SuffixClosure expr_prod_expanded)))
(let expr_tails_idempotent (TailsClosure (TailsClosure expr_prod_expanded)))
(let expr_fix_identity (Fixpoint expr1 "state" (Mention "state")))
(let expr_fix_independent (Fixpoint expr1 "state" (Static "new")))
(let expr_fix_state_static (Fixpoint expr1 "state" (Union (Mention "state") (Static "new"))))
(let expr_fix_static_state (Fixpoint expr1 "state" (Union (Static "new") (Mention "state"))))
(let expr_fix_tails (Fixpoint expr1 "state" (TailsUnion (Mention "state"))))
(let expr_fix_tails_static (Fixpoint expr1 "state" (Union (TailsUnion (Mention "state")) (Static "new"))))
(let expr_fix_static_tails (Fixpoint expr1 "state" (Union (Static "new") (TailsUnion (Mention "state")))))

(rewrite (LitEmpty) (Empty))

(rewrite (Union x x) x)
(rewrite (Intersection x x) x)

(rewrite (Subtraction x x) (Empty))

(rewrite (Union x y) (Union y x))
(rewrite (Intersection x y) (Intersection y x))

(rewrite (Union x (Empty)) x)
(rewrite (Union (Empty) x) x)
(rewrite (Intersection x (Empty)) (Empty))
(rewrite (Intersection (Empty) x) (Empty))
(rewrite (Intersection (Union x y) z) (Union (Intersection x z) (Intersection y z)))
(rewrite (Intersection x (Union y z)) (Union (Intersection x y) (Intersection x z)))
(rewrite (Subtraction (Empty) x) (Empty))
(rewrite (Subtraction x (Empty)) x)
(rewrite (Subtraction (Union x y) z) (Union (Subtraction x z) (Subtraction y z)))
(rewrite (Subtraction x (Union y z)) (Subtraction (Subtraction x y) z))
(rewrite (Subtraction (Singleton p) (Singleton q)) (Singleton p) :when ((!= p q)))
(rewrite (Intersection (Singleton p) (Singleton q)) (Empty) :when ((!= p q)))

(rewrite (Concat x (Eps)) x)
(rewrite (Concat (Eps) x) x)

(birewrite (Concat x (Concat y z)) (Concat (Concat x y) z))
(birewrite (Union x (Union y z)) (Union (Union x y) z))
(birewrite (Intersection x (Intersection y z)) (Intersection (Intersection x y) z))

(rewrite (Wrap x (Empty)) (Empty))
(rewrite (Wrap (Eps) s) s)
(birewrite (Wrap x (Singleton p)) (Singleton (Concat x p)))
(birewrite (Wrap x (Union s t)) (Union (Wrap x s) (Wrap x t)))

(rewrite (Unwrap (Empty) p) (Empty))
(rewrite (Unwrap s (Eps)) s)
(rewrite (Unwrap (Wrap p s) p) s)
(rewrite (Unwrap (Wrap (Concat p q) s) p) (Wrap q s))
(rewrite (Unwrap (Wrap p s) (Concat p q)) (Unwrap s q))
(rewrite (Unwrap (Union s t) x) (Union (Unwrap s x) (Unwrap t x)))

(rule ((= out (Unwrap (Singleton whole) prefix)))
      ((drop-prefix prefix whole out)))

(rule ((drop-prefix (Eps) whole out))
      ((union out (Singleton whole))))
(rule ((drop-prefix p p out))
      ((union out (Singleton (Eps)))))
(rule ((drop-prefix p (Concat p rest) out))
      ((union out (Singleton rest))))
(rule ((drop-prefix (Concat p q) (Concat p r) out))
      ((drop-prefix q r out)))
(rule ((drop-prefix (Item a) (Eps) out))
      ((union out (Empty))))
(rule ((drop-prefix (Concat (Item a) p) (Eps) out))
      ((union out (Empty))))
(rule ((drop-prefix (Item a) (Item b) out) (!= a b))
      ((union out (Empty))))
(rule ((drop-prefix (Item a) (Concat (Item b) r) out) (!= a b))
      ((union out (Empty))))
(rule ((drop-prefix (Concat (Item a) p) (Item b) out) (!= a b))
      ((union out (Empty))))
(rule ((drop-prefix (Concat (Item a) p) (Concat (Item b) r) out) (!= a b))
      ((union out (Empty))))

(rewrite (Product (Empty) t) (Empty))
(rewrite (Product s (Empty)) (Empty))
(rewrite (Product (Union s t) u) (Union (Product s u) (Product t u)))
(rewrite (Product s (Union t u)) (Union (Product s t) (Product s u)))
(rewrite (Product (Union (Singleton p) s) t) (Union (Wrap p t) (Product s t)))
(rewrite (Product (Singleton p) t) (Wrap p t))

(rewrite (TailsUnion (Empty)) (Empty))
(rewrite (TailsUnion (Union (Wrap (Item p) s) t)) (Union s (TailsUnion t)))
(rewrite (TailsUnion (Wrap (Item p) s)) s)

(rule ((= out (TailsIntersection x)))
      ((tails-intersection (Head x) x out)))
(rule ((tails-intersection (Singleton h) x out))
      ((union out (Unwrap x h))))
(rule ((tails-intersection (Union (Singleton h) rest) x out))
      ((tails-intersection-acc rest x (Unwrap x h) out)))
(rule ((tails-intersection-acc (Singleton h) x acc out))
      ((union out (Intersection acc (Unwrap x h)))))
(rule ((tails-intersection-acc (Union (Singleton h) rest) x acc out))
      ((tails-intersection-acc rest x (Intersection acc (Unwrap x h)) out)))

(rewrite (Restriction (Empty) p) (Empty))
(rewrite (Restriction x (Empty)) (Empty))
(rewrite (Restriction x (Singleton (Eps))) x)
(rewrite (Restriction x (Union p q)) (Union (Restriction x p) (Restriction x q)))
(rewrite (Restriction x (Singleton p)) (Wrap p (Unwrap x p)))

(rewrite (Head (Empty)) (Empty))
(rewrite (Head (Union x y)) (Union (Head x) (Head y)))
(rewrite (Head (Singleton (Concat (Item h) t))) (Singleton (Item h)))
(rewrite (Head (Singleton (Item h))) (Singleton (Item h)))

(run 12)

(check (= expr2 expr3))
(check (= expr1 expr4))
(check (= expr_qi_unwrap expr1))
(check (= expr_unwrap_prefix (Singleton (Item "b"))))
(check (= expr_unwrap_exact (Singleton (Eps))))
(check (= expr_unwrap_miss (Empty)))
(check (= expr_prod expr_prod_expanded))
(check (= expr_tailsunion1 expr1))
(check (= expr_tailsintersection1 expr1))
(check (= expr_restriction expr_restriction_res1))
(check (= expr_restriction_tailsintersection expr_s0))
(check (= expr_restriction_multi expr_restriction_multi_res))
(fail (check (= expr_restriction_multi expr_restriction_multi_only_a)))
(check (= expr_tailsintersection_duplicate_heads expr_s0))
(fail (check (= expr_tailsintersection_duplicate_heads (Empty))))
(check (= expr1_head expr1))
(check (= expr3_head (Singleton (Item "i"))))
(check (= expr_prod_head expr1_))

(rewrite (Iter (Empty) body) (Empty))
(rewrite (Iter (Singleton h) body) body)

(let iter_union_body (Union (Singleton (Item "l")) (Singleton (Item "r"))))
(let iter_union_empty (Iter (Empty) iter_union_body))
(let iter_union_distributed_empty
  (Union (Iter (Empty) (Singleton (Item "l")))
         (Iter (Empty) (Singleton (Item "r")))))
(let iter_union_hoisted_empty
  (Union (Singleton (Item "l"))
         (Iter (Empty) (Singleton (Item "r")))))
(let iter_union_headed (Iter (Singleton (Item "h")) iter_union_body))
(let iter_union_hoisted_headed
  (Union (Singleton (Item "l"))
         (Iter (Singleton (Item "h")) (Singleton (Item "r")))))
(let mutual_tag_a (Item "#mutual_fix.A"))
(let mutual_tag_b (Item "#mutual_fix.B"))
(let mutual_seed_a (Wrap mutual_tag_a (Singleton (Item "a"))))
(let mutual_seed_b (Wrap mutual_tag_b (Singleton (Item "b"))))
(let mutual_packed (Union mutual_seed_a mutual_seed_b))
(let mutual_project_a (Unwrap mutual_packed mutual_tag_a))
(let mutual_project_b (Unwrap mutual_packed mutual_tag_b))
(let mutual_unseeded_guard
  (Iter (Wrap mutual_tag_b (Empty))
        (Wrap mutual_tag_a (Static "leak"))))
(let mutual_seeded_guard
  (Iter mutual_seed_a
        (Wrap mutual_tag_b (Singleton (Item "b")))))

(run 4)

(check (= iter_union_empty (Empty)))
(check (= iter_union_empty iter_union_distributed_empty))
(fail (check (= iter_union_empty iter_union_hoisted_empty)))
(check (= iter_union_headed iter_union_hoisted_headed))
(check (= mutual_project_a (Singleton (Item "a"))))
(check (= mutual_project_b (Singleton (Item "b"))))
(check (= mutual_unseeded_guard (Empty)))
(check (= mutual_seeded_guard mutual_seed_b))

(rewrite (Range x "0" "0") x)
(rewrite (Range (Empty) start end) (Empty))
(rewrite (Union x (Range x start end)) x)
(rewrite (Union (Range x start end) x) x)
(rewrite (Intersection x (Range x start end)) (Range x start end))
(rewrite (Intersection (Range x start end) x) (Range x start end))
(rewrite (Subtraction (Range x start end) x) (Empty))
(rewrite (Range (Range x "0" "2") "0" "1") (Range x "0" "1"))
(rewrite (Range (Range x "0" "4") "2" "3") (Range x "2" "3"))
(rewrite (Range (Range x "0" "2") "2" "2") (Empty))

(rewrite (PrefixClosure (Empty)) (Empty))
(rewrite (SuffixClosure (Empty)) (Empty))
(rewrite (TailsClosure (Empty)) (Empty))
(rewrite (PrefixClosure (PrefixClosure x)) (PrefixClosure x))
(rewrite (SuffixClosure (SuffixClosure x)) (SuffixClosure x))
(rewrite (TailsClosure (TailsClosure x)) (TailsClosure x))
; These fixpoint checks encode the Scala side condition "step/static does not
; mention the state variable" by using the Static constructor.
(rewrite (Fixpoint init v (Mention v)) init)
(rewrite (Fixpoint init v (Static k)) (Union init (Static k)))
(rewrite (Fixpoint init v (Union (Mention v) (Static k))) (Union init (Static k)))
(rewrite (Fixpoint init v (Union (Static k) (Mention v))) (Union init (Static k)))
(rewrite (Fixpoint init v (TailsUnion (Mention v))) (TailsClosure init))
(rewrite (Fixpoint init v (Union (TailsUnion (Mention v)) (Static k))) (TailsClosure (Union init (Static k))))
(rewrite (Fixpoint init v (Union (Static k) (TailsUnion (Mention v)))) (TailsClosure (Union init (Static k))))

(run 2)

(check (= expr_empty_literal (Empty)))
(check (= expr_range_identity expr_prod_expanded))
(check (= expr_range_union_absorb expr_prod_expanded))
(check (= expr_range_intersection_absorb (Range expr_prod_expanded "0" "2")))
(check (= expr_range_sub_empty (Empty)))
(check (= expr_range_nested_01 (Range expr_prod_expanded "0" "1")))
(check (= expr_range_nested_12 (Range expr_prod_expanded "2" "3")))
(check (= expr_range_nested_empty (Empty)))
(check (= expr_prefix_empty (Empty)))
(check (= expr_suffix_empty (Empty)))
(check (= expr_tails_empty (Empty)))
(check (= expr_prefix_idempotent (PrefixClosure expr_prod_expanded)))
(check (= expr_suffix_idempotent (SuffixClosure expr_prod_expanded)))
(check (= expr_tails_idempotent (TailsClosure expr_prod_expanded)))
(check (= expr_fix_identity expr1))
(check (= expr_fix_independent (Union expr1 (Static "new"))))
(check (= expr_fix_state_static (Union expr1 (Static "new"))))
(check (= expr_fix_static_state (Union expr1 (Static "new"))))
(check (= expr_fix_tails (TailsClosure expr1)))
(check (= expr_fix_tails_static (TailsClosure (Union expr1 (Static "new")))))
(check (= expr_fix_static_tails (TailsClosure (Union expr1 (Static "new")))))
