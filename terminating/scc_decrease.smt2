; SMT-LIB twin of scc_decrease.p — all three recursive branches of the SCC split strictly
; shrink the node set: with a pivot v ∈ V, each of pred∩¬desc, desc∩¬pred, and
; (V \ pred) \ desc is a subset of V missing the pivot, so its card drops below card(V).
; STAGED: the six stepping stones are each PROVED from the axioms (push/pop goals 1-6),
; then asserted for the main theorem (goal 7) — z3 must answer "unsat" SEVEN times.
(declare-sort Node 0)
(declare-sort NSet 0)
(declare-fun mem (Node NSet) Bool)
(declare-fun subset (NSet NSet) Bool)
(declare-fun card (NSet) Int)
(declare-fun setminus (NSet NSet) NSet)
(declare-fun pred (NSet Node) NSet)
(declare-fun desc (NSet Node) NSet)
(assert (forall ((x Node) (a NSet) (b NSet))
  (= (mem x (setminus a b)) (and (mem x a) (not (mem x b))))))
(assert (forall ((a NSet) (b NSet))
  (= (subset a b) (forall ((x Node)) (=> (mem x a) (mem x b))))))
(assert (forall ((a NSet)) (>= (card a) 0)))
(assert (forall ((a NSet) (b NSet) (w Node))
  (=> (and (subset a b) (mem w b) (not (mem w a))) (< (card a) (card b)))))
(assert (forall ((v NSet) (p Node)) (mem p (pred v p))))
(assert (forall ((v NSet) (p Node)) (mem p (desc v p))))
(assert (forall ((v NSet) (p Node)) (=> (mem p v) (subset (pred v p) v))))
(assert (forall ((v NSet) (p Node)) (=> (mem p v) (subset (desc v p) v))))
; ---- stepping stones, proved from the axioms above ----
(push)
(assert (not (forall ((v NSet) (p Node))
  (=> (mem p v) (subset (setminus (pred v p) (desc v p)) v)))))
(check-sat)
(pop)
(push)
(assert (not (forall ((v NSet) (p Node))
  (=> (mem p v) (subset (setminus (desc v p) (pred v p)) v)))))
(check-sat)
(pop)
(push)
(assert (not (forall ((v NSet) (p Node))
  (=> (mem p v) (subset (setminus (setminus v (pred v p)) (desc v p)) v)))))
(check-sat)
(pop)
(push)
(assert (not (forall ((v NSet) (p Node)) (not (mem p (setminus (pred v p) (desc v p)))))))
(check-sat)
(pop)
(push)
(assert (not (forall ((v NSet) (p Node)) (not (mem p (setminus (desc v p) (pred v p)))))))
(check-sat)
(pop)
(push)
(assert (not (forall ((v NSet) (p Node))
  (not (mem p (setminus (setminus v (pred v p)) (desc v p)))))))
(check-sat)
(pop)
; ---- now asserted for the main theorem ----
(assert (forall ((v NSet) (p Node))
  (=> (mem p v) (subset (setminus (pred v p) (desc v p)) v))))
(assert (forall ((v NSet) (p Node))
  (=> (mem p v) (subset (setminus (desc v p) (pred v p)) v))))
(assert (forall ((v NSet) (p Node))
  (=> (mem p v) (subset (setminus (setminus v (pred v p)) (desc v p)) v))))
(assert (forall ((v NSet) (p Node)) (not (mem p (setminus (pred v p) (desc v p))))))
(assert (forall ((v NSet) (p Node)) (not (mem p (setminus (desc v p) (pred v p))))))
(assert (forall ((v NSet) (p Node))
  (not (mem p (setminus (setminus v (pred v p)) (desc v p))))))
(assert (not (forall ((v NSet) (p Node)) (=> (mem p v) (and
  (< (card (setminus (pred v p) (desc v p))) (card v))
  (< (card (setminus (desc v p) (pred v p))) (card v))
  (< (card (setminus (setminus v (pred v p)) (desc v p))) (card v)))))))
(check-sat)
