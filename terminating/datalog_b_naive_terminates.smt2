; SMT-LIB twin of datalog_b_naive_terminates.p — termination of the three NAIVE datalog_b.txt
; programs (tc / pt / rsg) with their argument updates transcribed from the printed ASTs:
;   gtc(R)  = e u comp(R, e)
;   gpt(R)  = addressof u comp(assign, R)
;   grsg(R) = flat u comp(comp(up, inv(R)), down)
; STAGED: every stepping stone is PROVED from the mem2 axioms as its own push/pop goal, then
; asserted for the theorem goals.  z3 must answer "unsat" FIFTEEN times: 4 monotonicity lemmas,
; subset-top, the top-specialized decrease, then one goal per conjunct per program
; (seed-expansion, invariant preservation, measure decrease  x  tc/pt/rsg).
(declare-sort Node 0)
(declare-sort NSet 0)
(declare-fun mem2 (Node Node NSet) Bool)
(declare-fun subset (NSet NSet) Bool)
(declare-fun card (NSet) Int)
(declare-fun setminus (NSet NSet) NSet)
(declare-fun cup (NSet NSet) NSet)
(declare-fun comp (NSet NSet) NSet)
(declare-fun inv (NSet) NSet)
(declare-const top NSet)
(declare-const e NSet)
(declare-const addressof NSet)
(declare-const assign NSet)
(declare-const up NSet)
(declare-const flat NSet)
(declare-const down NSet)
(declare-fun gtc (NSet) NSet)
(declare-fun gpt (NSet) NSet)
(declare-fun grsg (NSet) NSet)
(assert (forall ((x Node) (y Node) (a NSet) (b NSet))
  (= (mem2 x y (cup a b)) (or (mem2 x y a) (mem2 x y b)))))
(assert (forall ((a NSet) (b NSet))
  (= (subset a b) (forall ((x Node) (y Node)) (=> (mem2 x y a) (mem2 x y b))))))
(assert (forall ((x Node) (z Node) (a NSet) (b NSet))
  (= (mem2 x z (comp a b)) (exists ((y Node)) (and (mem2 x y a) (mem2 y z b))))))
(assert (forall ((x Node) (y Node) (a NSet))
  (= (mem2 x y (inv a)) (mem2 y x a))))
(assert (forall ((x Node) (y Node)) (mem2 x y top)))
; ASSUMED: T7
(assert (forall ((a NSet)) (>= (card a) 0)))
(assert (forall ((r NSet)) (= (gtc r) (cup e (comp r e)))))
(assert (forall ((r NSet)) (= (gpt r) (cup addressof (comp assign r)))))
(assert (forall ((r NSet)) (= (grsg r) (cup flat (comp (comp up (inv r)) down)))))
; ---- stepping stones, proved from the axioms above ----
(push)
(assert (not (forall ((a NSet) (b NSet) (c NSet))
  (=> (subset a b) (subset (comp a c) (comp b c))))))
(check-sat)
(pop)
(push)
(assert (not (forall ((a NSet) (b NSet) (c NSet))
  (=> (subset a b) (subset (comp c a) (comp c b))))))
(check-sat)
(pop)
(push)
(assert (not (forall ((a NSet) (b NSet))
  (=> (subset a b) (subset (inv a) (inv b))))))
(check-sat)
(pop)
(push)
(assert (not (forall ((a NSet) (b NSet) (c NSet))
  (=> (subset a b) (subset (cup c a) (cup c b))))))
(check-sat)
(pop)
(push)
(assert (not (forall ((a NSet)) (subset a top))))
(check-sat)
(pop)
; ---- now asserted, together with bounded_growth_decrease (its own twin), for the theorem ----
(assert (forall ((a NSet)) (subset a top)))
(assert (forall ((a NSet) (b NSet) (c NSet))
  (=> (subset a b) (subset (comp a c) (comp b c)))))
(assert (forall ((a NSet) (b NSet) (c NSet))
  (=> (subset a b) (subset (comp c a) (comp c b)))))
(assert (forall ((a NSet) (b NSet))
  (=> (subset a b) (subset (inv a) (inv b)))))
(assert (forall ((a NSet) (b NSet) (c NSet))
  (=> (subset a b) (subset (cup c a) (cup c b)))))
; ASSUMED: T7
(assert (forall ((r NSet) (s NSet) (u NSet))
  (=> (and (subset r s) (subset s u) (distinct s r))
      (< (card (setminus u s)) (card (setminus u r))))))
; top-specialized decrease (proved from the two premises above; gives the measure goals a
; directly-matching trigger — the general triple otherwise never instantiates at u=top)
(push)
(assert (not (forall ((r NSet) (s NSet))
  (=> (and (subset r s) (distinct s r))
      (< (card (setminus top s)) (card (setminus top r)))))))
(check-sat)
(pop)
(assert (forall ((r NSet) (s NSet))
  (=> (and (subset r s) (distinct s r))
      (< (card (setminus top s)) (card (setminus top r))))))
; the theorem, one goal per conjunct per program (bundled conjunctions defeat the
; incremental case split; each conjunct alone is immediate) — goals 7-15
(push)
(assert (not (forall ((r NSet)) (subset e (gtc r)))))
(check-sat)
(pop)
(push)
(assert (not (forall ((r NSet)) (=> (subset r (gtc r)) (subset (gtc r) (gtc (gtc r)))))))
(check-sat)
(pop)
(push)
(assert (not (forall ((r NSet)) (=> (and (subset r (gtc r)) (distinct (gtc r) r)) (< (card (setminus top (gtc r))) (card (setminus top r)))))))
(check-sat)
(pop)
(push)
(assert (not (forall ((r NSet)) (subset addressof (gpt r)))))
(check-sat)
(pop)
(push)
(assert (not (forall ((r NSet)) (=> (subset r (gpt r)) (subset (gpt r) (gpt (gpt r)))))))
(check-sat)
(pop)
(push)
(assert (not (forall ((r NSet)) (=> (and (subset r (gpt r)) (distinct (gpt r) r)) (< (card (setminus top (gpt r))) (card (setminus top r)))))))
(check-sat)
(pop)
(push)
(assert (not (forall ((r NSet)) (subset flat (grsg r)))))
(check-sat)
(pop)
(push)
(assert (not (forall ((r NSet)) (=> (subset r (grsg r)) (subset (grsg r) (grsg (grsg r)))))))
(check-sat)
(pop)
(push)
(assert (not (forall ((r NSet)) (=> (and (subset r (grsg r)) (distinct (grsg r) r)) (< (card (setminus top (grsg r))) (card (setminus top r)))))))
(check-sat)
(pop)
