; SMT-LIB twin of reachable_decrease.p — the masked-frontier step
;   step(R) = (R u frontier(R)) ∩ mask     (frontier UNINTERPRETED)
; stays inside the mask, is inflationary on masked arguments, and every non-fixpoint step
; strictly shrinks card(mask \ R).  STAGED like the .p: the five stepping stones are each
; PROVED from the axioms (push/pop goals 1-5), then asserted for the main theorem (goal 6) —
; z3 must answer "unsat" SIX times.
(declare-sort Node 0)
(declare-sort NSet 0)
(declare-fun mem (Node NSet) Bool)
(declare-fun subset (NSet NSet) Bool)
(declare-fun card (NSet) Int)
(declare-fun cup (NSet NSet) NSet)
(declare-fun cap (NSet NSet) NSet)
(declare-fun setminus (NSet NSet) NSet)
(declare-fun frontier (NSet) NSet)
(declare-const mask NSet)
(declare-fun step (NSet) NSet)
(assert (forall ((x Node) (a NSet) (b NSet))
  (= (mem x (cup a b)) (or (mem x a) (mem x b)))))
(assert (forall ((x Node) (a NSet) (b NSet))
  (= (mem x (cap a b)) (and (mem x a) (mem x b)))))
(assert (forall ((x Node) (a NSet) (b NSet))
  (= (mem x (setminus a b)) (and (mem x a) (not (mem x b))))))
(assert (forall ((a NSet) (b NSet))
  (= (subset a b) (forall ((x Node)) (=> (mem x a) (mem x b))))))
(assert (forall ((a NSet) (b NSet))
  (=> (forall ((x Node)) (= (mem x a) (mem x b))) (= a b))))
(assert (forall ((a NSet)) (>= (card a) 0)))
(assert (forall ((a NSet) (b NSet) (w Node))
  (=> (and (subset a b) (mem w b) (not (mem w a))) (< (card a) (card b)))))
(assert (forall ((r NSet)) (= (step r) (cap (cup r (frontier r)) mask))))
; ---- stepping stones, proved from the axioms above ----
(push)
(assert (not (forall ((r NSet)) (subset (step r) mask))))
(check-sat)
(pop)
(push)
(assert (not (forall ((r NSet)) (=> (subset r mask) (subset r (step r))))))
(check-sat)
(pop)
(push)
(assert (not (forall ((r NSet))
  (=> (subset r (step r)) (subset (setminus mask (step r)) (setminus mask r))))))
(check-sat)
(pop)
(push)
(assert (not (forall ((r NSet))
  (=> (and (subset r (step r)) (distinct (step r) r))
      (exists ((w Node)) (and (mem w (step r)) (not (mem w r))))))))
(check-sat)
(pop)
(push)
(assert (not (forall ((r NSet) (w Node))
  (=> (and (subset (step r) mask) (mem w (step r)) (not (mem w r)))
      (and (mem w (setminus mask r)) (not (mem w (setminus mask (step r)))))))))
(check-sat)
(pop)
; ---- now asserted for the main theorem ----
(assert (forall ((r NSet)) (subset (step r) mask)))
(assert (forall ((r NSet)) (=> (subset r mask) (subset r (step r)))))
(assert (forall ((r NSet))
  (=> (subset r (step r)) (subset (setminus mask (step r)) (setminus mask r)))))
(assert (forall ((r NSet))
  (=> (and (subset r (step r)) (distinct (step r) r))
      (exists ((w Node)) (and (mem w (step r)) (not (mem w r)))))))
(assert (forall ((r NSet) (w Node))
  (=> (and (subset (step r) mask) (mem w (step r)) (not (mem w r)))
      (and (mem w (setminus mask r)) (not (mem w (setminus mask (step r))))))))
(assert (not (forall ((r NSet)) (and
  (subset (step r) mask)
  (=> (subset r mask)
      (and (subset r (step r))
           (=> (distinct (step r) r)
               (< (card (setminus mask (step r))) (card (setminus mask r))))))))))
(check-sat)
