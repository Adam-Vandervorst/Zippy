; SPATIAL-SEMANTIC OBLIGATION — intersecting the children of MAY-PRESENT heads is UNSOUND for TailsIntersection
; GROUND WITNESS.  A shape with a closed head set {0,1}: head 0's child is may-present with no ε (`E=No`), head 1's child forces ε.  A concrete value where head 0 is ABSENT has ⋂_{present} tails = tails(1) ∋ ε, but `and`-ing both children gives `and(No, Must) = No`, i.e. 'ε absent'.  An absent head does not participate in the concrete intersection, so the true result can be strictly LARGER.  This is the witness SpatialLawCheck's second regression reproducer pins in the code; the repaired rule is certified in gsem_l2_tailsinter_closed_sound.
; Generated by scripts/gen_spatial_semantic_obligations.py.  Asserts the NEGATED theorem:
;   z3 unsat = PROVED, z3 sat = COUNTERMODEL.  Verdicts in proofs/spatial-semantic/STATUS.tsv.

; ── the ε channel: Presence, and its γ.  `inP p b` = "the 3-valued claim p is true of the fact b".
(declare-datatypes ((Pr 0)) (((pno) (pmay) (pmust))))
(define-fun por ((a Pr) (b Pr)) Pr
  (ite (or (= a pmust) (= b pmust)) pmust (ite (or (= a pmay) (= b pmay)) pmay pno)))
(define-fun pand ((a Pr) (b Pr)) Pr
  (ite (or (= a pno) (= b pno)) pno (ite (and (= a pmust) (= b pmust)) pmust pmay)))
(define-fun pminus ((a Pr) (b Pr)) Pr
  (ite (or (= a pno) (= b pmust)) pno (ite (and (= a pmust) (= b pno)) pmust pmay)))
(define-fun pweak ((a Pr)) Pr (ite (= a pmust) pmay a))
(define-fun inP ((p Pr) (b Bool)) Bool (and (=> (= p pno) (not b)) (=> (= p pmust) b)))
(define-fun n3 ((a Bool) (b Bool) (c Bool)) Int (+ (ite a 1 0) (ite b 1 0) (ite c 1 0)))

; head 0: may-present, no ε in its tails (E=pno, Q=pmay).  head 1: forces ε (E=pmust, Q=pno).
; concrete: head 0 ABSENT, head 1 present with the bare path.
(define-fun gammaShape () Bool
  (and (inP pno false) (inP pmay false)     ; head 0 tracked, concretely absent — admitted
       (inP pmust true) (inP pno false)))   ; head 1 tracked, present with ε in its tails
(define-fun eR () Bool true)                ; ⋂ over the PRESENT heads = tails(1) ∋ ε
(define-fun buggyE () Pr (pand pno pmust))  ; `and` over every LIVE head = pno
(assert (not (and gammaShape (= buggyE pno) (not (inP buggyE eR)))))
(check-sat)
