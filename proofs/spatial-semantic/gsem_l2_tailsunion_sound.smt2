; SPATIAL-SEMANTIC OBLIGATION — the L2 TAILSUNION transfer is γ-sound, and the untracked contribution needs OPEN COUNTS
; `TailsUnion` aggregates ACROSS heads, so the per-head reading of channel (d) is exactly wrong for it: an unknown number of tail-sets each admitted by the summary are unioned, and 'at most k untracked heads' is not preserved by that.  The transfer therefore folds `openCounts(otherTail)`.  Theorem, at depth 2 with a single grandchild item: the ε and x cells of ⋃_h tails(h) are bracketed by `or` over the tracked children and the opened summary.  (The count channels of the RESULT are not claimed here — that is what `openCounts` gives up.)
; Generated by scripts/gen_spatial_semantic_obligations.py.  Asserts the NEGATED theorem:
;   z3 unsat = PROVED, z3 sat = COUNTERMODEL.  Verdicts in proofs/spatial-semantic/STATUS.tsv.

; ── the ε channel: Presence, and its γ.  `inP p b` = "the 3-valued claim p is true of the fact b".
(declare-datatypes ((Pr 0)) (((pno) (pmay) (pmust))))
(define-fun por ((a Pr) (b Pr)) Pr
  (ite (or (= a pmust) (= b pmust)) pmust (ite (or (= a pmay) (= b pmay)) pmay pno)))
(define-fun pand ((a Pr) (b Pr)) Pr
  (ite (or (= a pno) (= b pno)) pno (ite (and (= a pmust) (= b pmust)) pmust pmay)))
(define-fun pminus ((a Pr) (b Pr)) Pr
  (ite (or (= a pno) (= b pmust)) pno (ite (and (= a pmust) (= b pno)) pmust pmay)))
(define-fun pweak ((a Pr)) Pr (ite (= a pmust) pmay a))
(define-fun inP ((p Pr) (b Bool)) Bool (and (=> (= p pno) (not b)) (=> (= p pmust) b)))
(define-fun n3 ((a Bool) (b Bool) (c Bool)) Int (+ (ite a 1 0) (ite b 1 0) (ite c 1 0)))
(declare-const Ea Pr)
(declare-const Ta0 Bool)
(declare-const Ea0 Pr)
(declare-const Qa0 Pr)
(declare-const Ta1 Bool)
(declare-const Ea1 Pr)
(declare-const Qa1 Pr)
(declare-const Ta2 Bool)
(declare-const Ea2 Pr)
(declare-const Qa2 Pr)
(declare-const Oloa Int)
(declare-const Ohia Int)
(declare-const Ha Bool)
(declare-const Eoa Pr)
(declare-const Qoa Pr)
(declare-const eA Bool)
(declare-const pA0 Bool)
(declare-const qA0 Bool)
(declare-const pA1 Bool)
(declare-const qA1 Bool)
(declare-const pA2 Bool)
(declare-const qA2 Bool)

; the result's two cells: ε ∈ ⋃ tails iff some PRESENT head has the bare path; x ∈ ⋃ tails iff some
; present head has h.x
(define-fun eR () Bool (or pA0 (or pA1 pA2)))
(define-fun qR () Bool (or qA0 (or qA1 qA2)))
; abstract: `or` over the tracked children and (when the head set is open) the summary
(define-fun sumE () Pr (ite (= Ohia 0) pno (ite Ha Eoa pmay)))
(define-fun sumQ () Pr (ite (= Ohia 0) pno (ite Ha Qoa pmay)))
(define-fun ER () Pr (por (por (ite Ta0 Ea0 pno) (por (ite Ta1 Ea1 pno) (ite Ta2 Ea2 pno))) sumE))
(define-fun QR () Pr (por (por (ite Ta0 Qa0 pno) (por (ite Ta1 Qa1 pno) (ite Ta2 Qa2 pno))) sumQ))
(assert (and (and (>= Oloa 0) (<= Oloa Ohia) (not (= Eoa pmust)) (not (= Qoa pmust))) (and (inP Ea eA) (=> Ta0 (and (inP Ea0 pA0) (inP Qa0 qA0))) (=> Ta1 (and (inP Ea1 pA1) (inP Qa1 qA1))) (=> Ta2 (and (inP Ea2 pA2) (inP Qa2 qA2))) (let ((u (n3 (and (not Ta0) (or pA0 qA0)) (and (not Ta1) (or pA1 qA1)) (and (not Ta2) (or pA2 qA2))))) (and (<= Oloa u) (<= u Ohia))) (=> Ha (and (=> (and (not Ta0) (or pA0 qA0)) (and (inP Eoa pA0) (inP Qoa qA0))) (=> (and (not Ta1) (or pA1 qA1)) (and (inP Eoa pA1) (inP Qoa qA1))) (=> (and (not Ta2) (or pA2 qA2)) (and (inP Eoa pA2) (inP Qoa qA2)))))) (not (and (inP ER eR) (inP QR qR)))))
(check-sat)
