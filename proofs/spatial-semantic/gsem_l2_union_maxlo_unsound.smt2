; SPATIAL-SEMANTIC OBLIGATION — the NAIVE others.lo = max(lo_a, lo_b) in the union transfer is UNSOUND
; GROUND WITNESS.  `a` tracks {0,1} and knows at least one UNTRACKED head is present; `b` tracks {0,1,2} and is closed and empty.  The result tracks {0,1,2}, so the head `a` could not name is now TRACKED and the untracked count is 0 — but `max(1,0) = 1` demands one.  Discounting by |keys(b) ∖ keys(a)| = 1 gives 0 and restores soundness on the same witness.  This certifies the correction carried in the current `Shape.union`.
; Generated by scripts/gen_spatial_semantic_obligations.py.  Asserts the NEGATED theorem:
;   z3 unsat = PROVED, z3 sat = COUNTERMODEL.  Verdicts in proofs/spatial-semantic/STATUS.tsv.

; ── the ε channel: Presence, and its γ.  `inP p b` = "the 3-valued claim p is true of the fact b".
(declare-datatypes ((Pr 0)) (((pno) (pmay) (pmust))))
(define-fun por ((a Pr) (b Pr)) Pr
  (ite (or (= a pmust) (= b pmust)) pmust (ite (or (= a pmay) (= b pmay)) pmay pno)))
(define-fun pand ((a Pr) (b Pr)) Pr
  (ite (or (= a pno) (= b pno)) pno (ite (and (= a pmust) (= b pmust)) pmust pmay)))
(define-fun pminus ((a Pr) (b Pr)) Pr
  (ite (or (= a pno) (= b pmust)) pno (ite (and (= a pmust) (= b pno)) pmust pmay)))
(define-fun pweak ((a Pr)) Pr (ite (= a pmust) pmay a))
(define-fun inP ((p Pr) (b Bool)) Bool (and (=> (= p pno) (not b)) (=> (= p pmust) b)))
(define-fun n3 ((a Bool) (b Bool) (c Bool)) Int (+ (ite a 1 0) (ite b 1 0) (ite c 1 0)))

; a: tracks heads 0 and 1, ε absent, both tracked children empty, ≥1 untracked head present, ⊤ summary
(define-fun ga () Bool
  (and (inP pno false)                 ; ε ∉ A
       (inP pno false) (inP pno false)  ; head 0 tracked, empty
       (inP pno false) (inP pno false)  ; head 1 tracked, empty
       (= (n3 false false true) 1)))    ; exactly one untracked head (head 2) present in A
; b: tracks 0,1,2, closed, and B = ∅
(define-fun gb () Bool (and (inP pno false) (= (n3 false false false) 0)))
; A ∪ B = A = {2}.  The result tracks 0,1,2 (union of the key sets), so head 2 is TRACKED.
(define-fun uUntracked () Int (n3 false false false))
(define-fun naiveLo () Int 1)          ; max(1, 0)
(define-fun fixedLo () Int 0)          ; relu(1 − |keys(b) ∖ keys(a)|) = relu(1 − 1)
(assert (not (and ga gb
                  (> naiveLo uUntracked)        ; the naive rule rejects the true union
                  (<= fixedLo uUntracked))))    ; the discounted rule admits it
(check-sat)
