; SPATIAL-SEMANTIC OBLIGATION — the CONCRETIZATION ORDER on the length-indexed type implies γ-CONTAINMENT
; `leqt(a,b) ⇒ γ(a) ⊆ γ(b)` for the full SpaceType representation on a 4-length window — both class endpoints, the SPILL AGGREGATE, and the spill length window.  proofs/spatial/sp_gamma_order.smt2 proves the one-interval case; this is the class-indexed carrier with the bucket, which is what SpatialGamma.leq actually decides.
; Generated by scripts/gen_spatial_semantic_obligations.py.  Asserts the NEGATED theorem:
;   z3 unsat = PROVED, z3 sat = COUNTERMODEL.  Verdicts in proofs/spatial-semantic/STATUS.tsv.

; ── ℕ∪{∞}: ∞ is a datatype constructor, so the modelled count domain is complete.  The CODE uses
;    Ivl.INF = Long.MaxValue, a sentinel; that difference is NOT modelled here.
(declare-datatypes ((Cnt 0)) (((fin (v Int)) (oo))))
(define-fun okc ((a Cnt)) Bool (or (= a oo) (>= (v a) 0)))
(define-fun cle ((a Cnt) (b Cnt)) Bool (ite (= b oo) true (ite (= a oo) false (<= (v a) (v b)))))
(define-fun cmin ((a Cnt) (b Cnt)) Cnt (ite (cle a b) a b))
(define-fun cmax ((a Cnt) (b Cnt)) Cnt (ite (cle a b) b a))
(define-fun cadd ((a Cnt) (b Cnt)) Cnt (ite (or (= a oo) (= b oo)) oo (fin (+ (v a) (v b)))))
(declare-datatypes ((Ivl 0)) (((mki (lo Cnt) (hi Cnt)))))
(define-fun oki ((i Ivl)) Bool (and (okc (lo i)) (okc (hi i))))
; ⊑ on intervals is INCLUSION on both endpoints
(define-fun ile ((a Ivl) (b Ivl)) Bool (and (cle (lo b) (lo a)) (cle (hi a) (hi b))))
(define-fun ijoin ((a Ivl) (b Ivl)) Ivl (mki (cmin (lo a) (lo b)) (cmax (hi a) (hi b))))
; γ of ONE class interval: which concrete counts it admits
(define-fun inI ((c Int) (i Ivl)) Bool (and (>= c 0) (cle (lo i) (fin c)) (cle (fin c) (hi i))))
; the CODE's per-class UNION transfer (SpatialTypes.join): lo = max, hi = saturating +
(define-fun ucls ((a Ivl) (b Ivl)) Ivl (mki (cmax (lo a) (lo b)) (cadd (hi a) (hi b))))

; ── the length-indexed count type on a WINDOW.  Classes 0 and 1 are TRACKED; lengths 2 and 3 are
;    covered by the single SPILL bucket `rst` whose length window is [rlo, rhi].  This is
;    SpaceType's representation and `SpatialGamma.gammaSpace` its γ — note the AGGREGATE constraint
;    on the spill, which is what a one-interval model cannot express.
(declare-datatypes ((Ty 0)) (((mkty (c0 Ivl) (c1 Ivl) (rst Ivl) (rlo Int) (rhi Int)))))
(define-fun okt ((t Ty)) Bool (and (oki (c0 t)) (oki (c1 t)) (oki (rst t)) (>= (rlo t) 0) (>= (rhi t) 0)))
; a concrete space, as its per-length counts.  n0 ≤ 1 because ε is the ONLY length-0 path.
(define-fun okv ((n0 Int) (n1 Int) (n2 Int) (n3 Int)) Bool
  (and (>= n0 0) (<= n0 1) (>= n1 0) (>= n2 0) (>= n3 0)))
(define-fun inG ((t Ty) (n0 Int) (n1 Int) (n2 Int) (n3 Int)) Bool
  (and (inI n0 (c0 t)) (inI n1 (c1 t))
       (inI (+ n2 n3) (rst t))
       (=> (> n2 0) (and (<= (rlo t) 2) (<= 2 (rhi t))))
       (=> (> n3 0) (and (<= (rlo t) 3) (<= 3 (rhi t))))))
; the order that IS γ-containment (SpatialGamma.leq specialised to this window).  Note the Scala
; `leqSpace` is STRICTLY MORE CONSERVATIVE (with equal tracked sets it additionally demands
; b.rest.lo = 0), so `leqSpace ⇒ leqt`, and a theorem about leqt covers it.
(define-fun leqt ((a Ty) (b Ty)) Bool
  (and (ile (c0 a) (c0 b)) (ile (c1 a) (c1 b)) (ile (rst a) (rst b))
       (or (= (hi (rst a)) (fin 0))
           (and (<= (rlo b) (rlo a)) (<= (rhi a) (rhi b))))))
; the CODE's `SpaceType.within` — UPPER ENVELOPES ONLY, every lower bound ignored
(define-fun withint ((a Ty) (b Ty)) Bool
  (and (cle (hi (c0 a)) (hi (c0 b))) (cle (hi (c1 a)) (hi (c1 b))) (cle (hi (rst a)) (hi (rst b)))
       (or (= (hi (rst a)) (fin 0))
           (and (<= (rlo b) (rlo a)) (<= (rhi a) (rhi b))))))
; the LATTICE join (SpatialGamma.lubSpace, closed case): class-wise hull + window hull
(define-fun lubt ((a Ty) (b Ty)) Ty
  (mkty (ijoin (c0 a) (c0 b)) (ijoin (c1 a) (c1 b)) (ijoin (rst a) (rst b))
        (ite (<= (rlo a) (rlo b)) (rlo a) (rlo b)) (ite (<= (rhi a) (rhi b)) (rhi b) (rhi a))))
; the CODE's `SpatialTypes.join` — the UNION transfer, applied class-wise
(define-fun jointy ((a Ty) (b Ty)) Ty
  (mkty (ucls (c0 a) (c0 b)) (ucls (c1 a) (c1 b)) (ucls (rst a) (rst b))
        (ite (<= (rlo a) (rlo b)) (rlo a) (rlo b)) (ite (<= (rhi a) (rhi b)) (rhi b) (rhi a))))

(declare-const a Ty) (declare-const b Ty)
(declare-const n0 Int) (declare-const n1 Int) (declare-const n2 Int) (declare-const n3 Int)
(assert (and (okt a) (okt b) (okv n0 n1 n2 n3)
             (leqt a b) (inG a n0 n1 n2 n3) (not (inG b n0 n1 n2 n3))))
(check-sat)
