(assert (and (and (>= Oloa 0) (<= Oloa Ohia) (not (= Eoa pmust)) (not (= Qoa pmust))) (and (>= Olob 0) (<= Olob Ohib) (not (= Eob pmust)) (not (= Qob pmust))) (and (inP Ea eA) (=> Ta0 (and (inP Ea0 pA0) (inP Qa0 qA0))) (=> Ta1 (and (inP Ea1 pA1) (inP Qa1 qA1))) (=> Ta2 (and (inP Ea2 pA2) (inP Qa2 qA2))) (let ((u (n3 (and (not Ta0) (or pA0 qA0)) (and (not Ta1) (or pA1 qA1)) (and (not Ta2) (or pA2 qA2))))) (and (<= Oloa u) (<= u Ohia))) (=> Ha (and (=> (and (not Ta0) (or pA0 qA0)) (and (inP Eoa pA0) (inP Qoa qA0))) (=> (and (not Ta1) (or pA1 qA1)) (and (inP Eoa pA1) (inP Qoa qA1))) (=> (and (not Ta2) (or pA2 qA2)) (and (inP Eoa pA2) (inP Qoa qA2)))))) (and (inP Eb eB) (=> Tb0 (and (inP Eb0 pB0) (inP Qb0 qB0))) (=> Tb1 (and (inP Eb1 pB1) (inP Qb1 qB1))) (=> Tb2 (and (inP Eb2 pB2) (inP Qb2 qB2))) (let ((u (n3 (and (not Tb0) (or pB0 qB0)) (and (not Tb1) (or pB1 qB1)) (and (not Tb2) (or pB2 qB2))))) (and (<= Olob u) (<= u Ohib))) (=> Hb (and (=> (and (not Tb0) (or pB0 qB0)) (and (inP Eob pB0) (inP Qob qB0))) (=> (and (not Tb1) (or pB1 qB1)) (and (inP Eob pB1) (inP Qob qB1))) (=> (and (not Tb2) (or pB2 qB2)) (and (inP Eob pB2) (inP Qob qB2)))))) (not gammaU)))
