(define-fun Ohi () Int (ite closedBoth 0 (+ Ohia Ohib)))
; the per-head summary: ∅ for a closed side, else its own summary (⊤ = pmay when absent)
(define-fun atE () Pr (ite (= Ohia 0) pno (ite Ha Eoa pmay)))
