; SPATIAL-SEMANTIC OBLIGATION — the HEAD-COUNT bounds for ∪, ∩, ∖ and <| over a 3-head universe
; `Shape.headCount` is the group count of an `Iteration`, the fact the length histogram cannot express at all (review.md 1).  Theorem: the number of DISTINCT heads of A∪B is at most the sum and at least each side's; of A∩B at most the minimum; of A∖B and A<|B at most A's; and with CLOSED head sets the union's head set is exactly the union of the two.  Stated on the concrete sets, which is what the abstract rule has to bracket.
; Generated by scripts/gen_spatial_semantic_obligations.py.  Asserts the NEGATED theorem:
;   z3 unsat = PROVED, z3 sat = COUNTERMODEL.  Verdicts in proofs/spatial-semantic/STATUS.tsv.

; ── the ε channel: Presence, and its γ.  `inP p b` = "the 3-valued claim p is true of the fact b".
(declare-datatypes ((Pr 0)) (((pno) (pmay) (pmust))))
(define-fun por ((a Pr) (b Pr)) Pr
  (ite (or (= a pmust) (= b pmust)) pmust (ite (or (= a pmay) (= b pmay)) pmay pno)))
(define-fun pand ((a Pr) (b Pr)) Pr
  (ite (or (= a pno) (= b pno)) pno (ite (and (= a pmust) (= b pmust)) pmust pmay)))
(define-fun pminus ((a Pr) (b Pr)) Pr
  (ite (or (= a pno) (= b pmust)) pno (ite (and (= a pmust) (= b pno)) pmust pmay)))
(define-fun pweak ((a Pr)) Pr (ite (= a pmust) pmay a))
(define-fun inP ((p Pr) (b Bool)) Bool (and (=> (= p pno) (not b)) (=> (= p pmust) b)))
(define-fun n3 ((a Bool) (b Bool) (c Bool)) Int (+ (ite a 1 0) (ite b 1 0) (ite c 1 0)))

(declare-const a0 Bool) (declare-const a1 Bool) (declare-const a2 Bool)
(declare-const b0 Bool) (declare-const b1 Bool) (declare-const b2 Bool)
(declare-const eb Bool)
(define-fun HA () Int (n3 a0 a1 a2))
(define-fun HB () Int (n3 b0 b1 b2))
(define-fun HU () Int (n3 (or a0 b0) (or a1 b1) (or a2 b2)))
(define-fun HI () Int (n3 (and a0 b0) (and a1 b1) (and a2 b2)))
(define-fun HS () Int (n3 (and a0 (not b0)) (and a1 (not b1)) (and a2 (not b2))))
; depth-1 restriction: head h survives iff a_h ∧ (ε ∈ B ∨ b_h)
(define-fun HR () Int (n3 (and a0 (or eb b0)) (and a1 (or eb b1)) (and a2 (or eb b2))))
(assert (or
  (> HU (+ HA HB))                                  ; union ≤ sum
  (< HU HA) (< HU HB)                               ; union ≥ each side
  (> HI HA) (> HI HB)                               ; meet ≤ min
  (> HS HA)                                         ; difference ≤ minuend
  (> HR HA)                                         ; restriction ≤ restricted side
  (not (= HU (+ HA (- HB HI))))))                   ; closed sets: |A ∪ B| = |A| + |B| − |A ∩ B|
(check-sat)
