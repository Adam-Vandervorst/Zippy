; SPATIAL-SEMANTIC OBLIGATION — TailsIntersection IS sound when the participant set is exactly known
; The repaired rule: MUST is restored only when the head set is CLOSED and every live head is MUST-present, so the set of participating heads is exactly the set of live heads.  Theorem at depth 2 with a single grandchild item: under that guard, `and` over the live children brackets both cells of ⋂_{present} tails(h).  Modelled with 2 heads (a third adds no case).
; Generated by scripts/gen_spatial_semantic_obligations.py.  Asserts the NEGATED theorem:
;   z3 unsat = PROVED, z3 sat = COUNTERMODEL.  Verdicts in proofs/spatial-semantic/STATUS.tsv.

; ── the ε channel: Presence, and its γ.  `inP p b` = "the 3-valued claim p is true of the fact b".
(declare-datatypes ((Pr 0)) (((pno) (pmay) (pmust))))
(define-fun por ((a Pr) (b Pr)) Pr
  (ite (or (= a pmust) (= b pmust)) pmust (ite (or (= a pmay) (= b pmay)) pmay pno)))
(define-fun pand ((a Pr) (b Pr)) Pr
  (ite (or (= a pno) (= b pno)) pno (ite (and (= a pmust) (= b pmust)) pmust pmay)))
(define-fun pminus ((a Pr) (b Pr)) Pr
  (ite (or (= a pno) (= b pmust)) pno (ite (and (= a pmust) (= b pno)) pmust pmay)))
(define-fun pweak ((a Pr)) Pr (ite (= a pmust) pmay a))
(define-fun inP ((p Pr) (b Bool)) Bool (and (=> (= p pno) (not b)) (=> (= p pmust) b)))
(define-fun n3 ((a Bool) (b Bool) (c Bool)) Int (+ (ite a 1 0) (ite b 1 0) (ite c 1 0)))

(declare-const E0 Pr) (declare-const Q0 Pr) (declare-const E1 Pr) (declare-const Q1 Pr)
(declare-const p0 Bool) (declare-const q0 Bool) (declare-const p1 Bool) (declare-const q1 Bool)
(define-fun live ((e Pr) (q Pr)) Bool (not (and (= e pno) (= q pno))))
(define-fun mustNE ((e Pr) (q Pr)) Bool (or (= e pmust) (= q pmust)))
; the GUARD: closed head set, and every live head must-present, and at least one live head
(define-fun guard () Bool
  (and (=> (live E0 Q0) (mustNE E0 Q0)) (=> (live E1 Q1) (mustNE E1 Q1))
       (or (live E0 Q0) (live E1 Q1))))
(define-fun g () Bool (and (inP E0 p0) (inP Q0 q0) (inP E1 p1) (inP Q1 q1)))
(define-fun pres0 () Bool (or p0 q0))
(define-fun pres1 () Bool (or p1 q1))
; ⋂ over the PRESENT heads (∅ when none is present, which `guard` excludes)
(define-fun eR () Bool (and (=> pres0 p0) (=> pres1 p1)))
(define-fun qR () Bool (and (=> pres0 q0) (=> pres1 q1)))
; the transfer: `and` over the live children only
(define-fun ER () Pr (ite (and (live E0 Q0) (live E1 Q1)) (pand E0 E1) (ite (live E0 Q0) E0 E1)))
(define-fun QR () Pr (ite (and (live E0 Q0) (live E1 Q1)) (pand Q0 Q1) (ite (live E0 Q0) Q0 Q1)))
(assert (and guard g (not (and (inP ER eR) (inP QR qR)))))
(check-sat)
