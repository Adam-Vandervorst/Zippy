(define-fun closedX () Bool (= Ohix 0))
(define-fun closedP () Bool (= Ohip 0))
(define-fun T0 () Bool (ite (and closedX closedP) (and Tx0 Tp0) (ite closedX Tx0 (ite closedP Tp0 (or Tx0 Tp0)))))
(define-fun T1 () Bool (ite (and closedX closedP) (and Tx1 Tp1) (ite closedX Tx1 (ite closedP Tp1 (or Tx1 Tp1)))))
(define-fun T2 () Bool (ite (and closedX closedP) (and Tx2 Tp2) (ite closedX Tx2 (ite closedP Tp2 (or Tx2 Tp2)))))

(define-fun E () Pr (pand Ex Ep))
; a head survives when x may have it AND (ε ∈ prefixes OR prefixes may have it)
(define-fun C0 () Pr (ite (= Ep pmust) (ite Tx0 Cx0 (ite (= Ohix 0) pno (ite Hx (pweak Cox) pmay))) (pand (ite Tx0 Cx0 (ite (= Ohix 0) pno (ite Hx (pweak Cox) pmay))) (por (pweak Ep) (ite Tp0 Cp0 (ite (= Ohip 0) pno (ite Hp (pweak Cop) pmay)))))))
(define-fun C1 () Pr (ite (= Ep pmust) (ite Tx1 Cx1 (ite (= Ohix 0) pno (ite Hx (pweak Cox) pmay))) (pand (ite Tx1 Cx1 (ite (= Ohix 0) pno (ite Hx (pweak Cox) pmay))) (por (pweak Ep) (ite Tp1 Cp1 (ite (= Ohip 0) pno (ite Hp (pweak Cop) pmay)))))))
(define-fun C2 () Pr (ite (= Ep pmust) (ite Tx2 Cx2 (ite (= Ohix 0) pno (ite Hx (pweak Cox) pmay))) (pand (ite Tx2 Cx2 (ite (= Ohix 0) pno (ite Hx (pweak Cox) pmay))) (por (pweak Ep) (ite Tp2 Cp2 (ite (= Ohip 0) pno (ite Hp (pweak Cop) pmay)))))))

(define-fun Olo () Int 0)
(define-fun Ohi () Int (ite (or closedX closedP) 0 (ite (<= Ohix Ohip) Ohix Ohip)))
(define-fun Co () Pr (ite Hx (pweak Cox) pmay))
; the CONCRETE restriction
(define-fun eR () Bool (and eA eB))
(define-fun pR0 () Bool (and pA0 (or eB pB0)))
(define-fun pR1 () Bool (and pA1 (or eB pB1)))
(define-fun pR2 () Bool (and pA2 (or eB pB2)))

(define-fun gammaR () Bool
  (and (inP E eR)
       (=> T0 (inP C0 pR0)) (=> T1 (inP C1 pR1)) (=> T2 (inP C2 pR2))
       (let ((u (n3 (and (not T0) pR0) (and (not T1) pR1) (and (not T2) pR2))))
         (and (<= Olo u) (<= u Ohi)))
       (=> (and (not T0) pR0) (inP Co pR0)) (=> (and (not T1) pR1) (inP Co pR1)) (=> (and (not T2) pR2) (inP Co pR2))))
(assert (and (and (>= Olox 0) (<= Olox Ohix) (not (= Cox pmust))) (and (>= Olop 0) (<= Olop Ohip) (not (= Cop pmust))) (= Ep pno)
             (and (inP Ex eA) (=> Tx0 (inP Cx0 pA0)) (=> Tx1 (inP Cx1 pA1)) (=> Tx2 (inP Cx2 pA2)) (let ((u (n3 (and (not Tx0) pA0) (and (not Tx1) pA1) (and (not Tx2) pA2)))) (and (<= Olox u) (<= u Ohix))) (=> Hx (and (=> (and (not Tx0) pA0) (inP Cox pA0)) (=> (and (not Tx1) pA1) (inP Cox pA1)) (=> (and (not Tx2) pA2) (inP Cox pA2))))) (and (inP Ep eB) (=> Tp0 (inP Cp0 pB0)) (=> Tp1 (inP Cp1 pB1)) (=> Tp2 (inP Cp2 pB2)) (let ((u (n3 (and (not Tp0) pB0) (and (not Tp1) pB1) (and (not Tp2) pB2)))) (and (<= Olop u) (<= u Ohip))) (=> Hp (and (=> (and (not Tp0) pB0) (inP Cop pB0)) (=> (and (not Tp1) pB1) (inP Cop pB1)) (=> (and (not Tp2) pB2) (inP Cop pB2))))) (not gammaR)))
(check-sat)
