; ── the ε channel: Presence, and its γ.  `inP p b` = "the 3-valued claim p is true of the fact b".
(declare-datatypes ((Pr 0)) (((pno) (pmay) (pmust))))
(define-fun por ((a Pr) (b Pr)) Pr
  (ite (or (= a pmust) (= b pmust)) pmust (ite (or (= a pmay) (= b pmay)) pmay pno)))
(define-fun pand ((a Pr) (b Pr)) Pr
  (ite (or (= a pno) (= b pno)) pno (ite (and (= a pmust) (= b pmust)) pmust pmay)))
(define-fun pminus ((a Pr) (b Pr)) Pr
  (ite (or (= a pno) (= b pmust)) pno (ite (and (= a pmust) (= b pno)) pmust pmay)))
(define-fun pweak ((a Pr)) Pr (ite (= a pmust) pmay a))
(define-fun inP ((p Pr) (b Bool)) Bool (and (=> (= p pno) (not b)) (=> (= p pmust) b)))
(define-fun n3 ((a Bool) (b Bool) (c Bool)) Int (+ (ite a 1 0) (ite b 1 0) (ite c 1 0)))

; x: ε absent, tracks {0,1} both empty, head set OPEN with exactly one untracked head present
(define-fun gx () Bool (and (inP pno false) (inP pno false) (inP pno false) (= (n3 false false true) 1)))
; prefixes: closed, exactly the path `2`
(define-fun gp () Bool (and (inP pno false) (= (n3 false false true) 1)))
; the restriction keeps the path `2`: head 2 IS present in the result
(define-fun resultHead2 () Bool true)
(define-fun buggyKeys () Int 0)          ; |tracked(x) ∩ tracked(p)| = |{0,1} ∩ {2}| = 0
(define-fun buggyClosed () Bool true)    ; and the result was then treated as closed
(define-fun fixedKeysHas2 () Bool true)  ; the repaired rule takes tracked(p) = {2}
