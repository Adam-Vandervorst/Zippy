; SPATIAL-SEMANTIC OBLIGATION — α/γ ADJUNCTION on the per-class count interval
; extensivity (c ∈ γ(α{c})), reductivity (α(γ t) ⊑ t, with equality when t is consistent), and BOTH directions of the adjunction α S ⊑ t ⟺ S ⊆ γ t for a 3-element S.  This is the Galois core the class-indexed results below are built from.
; Generated by scripts/gen_spatial_semantic_obligations.py.  Asserts the NEGATED theorem:
;   z3 unsat = PROVED, z3 sat = COUNTERMODEL.  Verdicts in proofs/spatial-semantic/STATUS.tsv.

; ── ℕ∪{∞}: ∞ is a datatype constructor, so the modelled count domain is complete.  The CODE uses
;    Ivl.INF = Long.MaxValue, a sentinel; that difference is NOT modelled here.
(declare-datatypes ((Cnt 0)) (((fin (v Int)) (oo))))
(define-fun okc ((a Cnt)) Bool (or (= a oo) (>= (v a) 0)))
(define-fun cle ((a Cnt) (b Cnt)) Bool (ite (= b oo) true (ite (= a oo) false (<= (v a) (v b)))))
(define-fun cmin ((a Cnt) (b Cnt)) Cnt (ite (cle a b) a b))
(define-fun cmax ((a Cnt) (b Cnt)) Cnt (ite (cle a b) b a))
(define-fun cadd ((a Cnt) (b Cnt)) Cnt (ite (or (= a oo) (= b oo)) oo (fin (+ (v a) (v b)))))
(declare-datatypes ((Ivl 0)) (((mki (lo Cnt) (hi Cnt)))))
(define-fun oki ((i Ivl)) Bool (and (okc (lo i)) (okc (hi i))))
; ⊑ on intervals is INCLUSION on both endpoints
(define-fun ile ((a Ivl) (b Ivl)) Bool (and (cle (lo b) (lo a)) (cle (hi a) (hi b))))
(define-fun ijoin ((a Ivl) (b Ivl)) Ivl (mki (cmin (lo a) (lo b)) (cmax (hi a) (hi b))))
; γ of ONE class interval: which concrete counts it admits
(define-fun inI ((c Int) (i Ivl)) Bool (and (>= c 0) (cle (lo i) (fin c)) (cle (fin c) (hi i))))
; the CODE's per-class UNION transfer (SpatialTypes.join): lo = max, hi = saturating +
(define-fun ucls ((a Ivl) (b Ivl)) Ivl (mki (cmax (lo a) (lo b)) (cadd (hi a) (hi b))))

(declare-const c1 Int) (declare-const c2 Int) (declare-const c3 Int)
(declare-const t Ivl) (declare-const d Ivl)
(define-fun mn3 ((a Int) (b Int) (c Int)) Int (ite (<= a b) (ite (<= a c) a c) (ite (<= b c) b c)))
(define-fun mx3 ((a Int) (b Int) (c Int)) Int (ite (>= a b) (ite (>= a c) a c) (ite (>= b c) b c)))
; α of a 3-element set of counts is the tightest interval containing them
(define-fun alpha3 ((a Int) (b Int) (c Int)) Ivl (mki (fin (mn3 a b c)) (fin (mx3 a b c))))
(define-fun nonneg () Bool (and (>= c1 0) (>= c2 0) (>= c3 0)))
; a CONSISTENT interval with finite endpoints — the shape α ever produces
(define-fun consistent ((i Ivl)) Bool (and (oki i) (not (= (lo i) oo)) (not (= (hi i) oo)) (cle (lo i) (hi i))))
(assert (or
  ; (i) EXTENSIVE
  (and (>= c1 0) (not (inI c1 (alpha3 c1 c1 c1))))
  ; (ii) ADJUNCTION ⇐ : S ⊆ γ t ⇒ α S ⊑ t  (α is the BEST abstraction)
  (and nonneg (oki t) (inI c1 t) (inI c2 t) (inI c3 t) (not (ile (alpha3 c1 c2 c3) t)))
  ; (iii) ADJUNCTION ⇒ : α S ⊑ t ⇒ S ⊆ γ t
  (and nonneg (oki t) (ile (alpha3 c1 c2 c3) t) (not (and (inI c1 t) (inI c2 t) (inI c3 t))))
  ; (iv) REDUCTIVE, and TIGHT: for a consistent finite t, α(γ t) = t (both endpoints are attained)
  (and (consistent d) (not (= (alpha3 (v (lo d)) (v (lo d)) (v (hi d))) d)))))
(check-sat)
