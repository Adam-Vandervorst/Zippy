; Generated by morkl.CornerstoneProofArtifactMain
; Example: aunt
; Aunt graph query over the committed tiny family graph.

(datatype Cert
  (trie_eval String)
  (reference_eval String)
  (source_optimized String)
  (source_original String)
  (zipper_materialized String)
  (space_eval_trie String)
  (graph_execT String)
  (Result String))

(let $trie_eval (trie_eval "aunt"))
(let $reference_eval (reference_eval "aunt"))
(let $source_optimized (source_optimized "aunt"))
(let $source_original (source_original "aunt"))
(let $zipper_materialized (zipper_materialized "aunt"))
(let $space_eval_trie (space_eval_trie "aunt"))
(let $graph_execT (graph_execT "aunt"))

; trie_vs_reference: Trie evaluator output equals reference set evaluator output.
(rewrite (trie_eval "aunt") (Result "a49b8dddcc87b1e175732592"))
(rewrite (reference_eval "aunt") (Result "a49b8dddcc87b1e175732592"))

; space_optimized: Default source optimizer output equals original Space/term output.
(rewrite (source_optimized "aunt") (Result "a49b8dddcc87b1e175732592"))
(rewrite (source_original "aunt") (Result "a49b8dddcc87b1e175732592"))
; zipper_vs_space: Scala zipper program materialization equals eager Space/Trie evaluation.
(rewrite (zipper_materialized "aunt") (Result "a49b8dddcc87b1e175732592"))
(rewrite (space_eval_trie "aunt") (Result "a49b8dddcc87b1e175732592"))
; graph_execT_vs_space: Scala operation graph execT output equals eager Space/Trie evaluation.
(rewrite (graph_execT "aunt") (Result "a49b8dddcc87b1e175732592"))
(run 10)

(check (= $trie_eval $reference_eval))

(check (= $source_optimized $source_original))

(check (= $zipper_materialized $space_eval_trie))

(check (= $graph_execT $space_eval_trie))

