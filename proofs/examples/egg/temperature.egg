; Generated by morkl.CornerstoneProofArtifactMain
; Example: temperature
; Small prefix-coded spatial temperature slice shaped like the NOAA query.

(datatype Cert
  (trie_eval String)
  (reference_eval String)
  (source_optimized String)
  (source_original String)
  (zipper_materialized String)
  (space_eval_trie String)
  (graph_execT String)
  (Result String))

(let $trie_eval (trie_eval "temperature"))
(let $reference_eval (reference_eval "temperature"))
(let $source_optimized (source_optimized "temperature"))
(let $source_original (source_original "temperature"))
(let $zipper_materialized (zipper_materialized "temperature"))
(let $space_eval_trie (space_eval_trie "temperature"))
(let $graph_execT (graph_execT "temperature"))

; trie_vs_reference: Trie evaluator output equals reference set evaluator output.
(rewrite (trie_eval "temperature") (Result "cdc9e2ccc913556de492214b"))
(rewrite (reference_eval "temperature") (Result "cdc9e2ccc913556de492214b"))

; space_optimized: Default source optimizer output equals original Space/term output.
(rewrite (source_optimized "temperature") (Result "cdc9e2ccc913556de492214b"))
(rewrite (source_original "temperature") (Result "cdc9e2ccc913556de492214b"))
; zipper_vs_space: Scala zipper program materialization equals eager Space/Trie evaluation.
(rewrite (zipper_materialized "temperature") (Result "cdc9e2ccc913556de492214b"))
(rewrite (space_eval_trie "temperature") (Result "cdc9e2ccc913556de492214b"))
; graph_execT_vs_space: Scala operation graph execT output equals eager Space/Trie evaluation.
(rewrite (graph_execT "temperature") (Result "cdc9e2ccc913556de492214b"))
(run 10)

(check (= $trie_eval $reference_eval))

(check (= $source_optimized $source_original))

(check (= $zipper_materialized $space_eval_trie))

(check (= $graph_execT $space_eval_trie))

