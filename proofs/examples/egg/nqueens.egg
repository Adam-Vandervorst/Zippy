; Generated by morkl.CornerstoneProofArtifactMain
; Example: nqueens
; Pure MORKL 4-queens search; the benchmark suite scales this definition higher.

(datatype Cert
  (trie_eval String)
  (reference_eval String)
  (source_optimized String)
  (source_original String)
  (zipper_materialized String)
  (space_eval_trie String)
  (graph_execT String)
  (Result String))

(let $trie_eval (trie_eval "nqueens"))
(let $reference_eval (reference_eval "nqueens"))
(let $source_optimized (source_optimized "nqueens"))
(let $source_original (source_original "nqueens"))
(let $zipper_materialized (zipper_materialized "nqueens"))
(let $space_eval_trie (space_eval_trie "nqueens"))
(let $graph_execT (graph_execT "nqueens"))

; trie_vs_reference: Trie evaluator output equals reference set evaluator output.
(rewrite (trie_eval "nqueens") (Result "0d3b049b52c0e9f10bfdb489"))
(rewrite (reference_eval "nqueens") (Result "0d3b049b52c0e9f10bfdb489"))

; space_optimized: Default source optimizer output equals original Space/term output.
(rewrite (source_optimized "nqueens") (Result "0d3b049b52c0e9f10bfdb489"))
(rewrite (source_original "nqueens") (Result "0d3b049b52c0e9f10bfdb489"))
; zipper_vs_space: Scala zipper program materialization equals eager Space/Trie evaluation.
(rewrite (zipper_materialized "nqueens") (Result "0d3b049b52c0e9f10bfdb489"))
(rewrite (space_eval_trie "nqueens") (Result "0d3b049b52c0e9f10bfdb489"))
; graph_execT_vs_space: Scala operation graph execT output equals eager Space/Trie evaluation.
(rewrite (graph_execT "nqueens") (Result "0d3b049b52c0e9f10bfdb489"))
(run 10)

(check (= $trie_eval $reference_eval))

(check (= $source_optimized $source_original))

(check (= $zipper_materialized $space_eval_trie))

(check (= $graph_execT $space_eval_trie))

