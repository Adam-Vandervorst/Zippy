; Generated by morkl.CornerstoneProofArtifactMain
; Example: 15-puzzle
; One legal 15-puzzle frontier expansion from the solved 4x4 state.

(datatype Cert
  (trie_eval String)
  (reference_eval String)
  (source_optimized String)
  (source_original String)
  (zipper_materialized String)
  (space_eval_trie String)
  (graph_execT String)
  (Result String))

(let $trie_eval (trie_eval "15-puzzle"))
(let $reference_eval (reference_eval "15-puzzle"))
(let $source_optimized (source_optimized "15-puzzle"))
(let $source_original (source_original "15-puzzle"))
(let $zipper_materialized (zipper_materialized "15-puzzle"))
(let $space_eval_trie (space_eval_trie "15-puzzle"))
(let $graph_execT (graph_execT "15-puzzle"))

; trie_vs_reference: Trie evaluator output equals reference set evaluator output.
(rewrite (trie_eval "15-puzzle") (Result "5f7f76bc432e2f7a13fc479d"))
(rewrite (reference_eval "15-puzzle") (Result "5f7f76bc432e2f7a13fc479d"))

; space_optimized: Default source optimizer output equals original Space/term output.
(rewrite (source_optimized "15-puzzle") (Result "5f7f76bc432e2f7a13fc479d"))
(rewrite (source_original "15-puzzle") (Result "5f7f76bc432e2f7a13fc479d"))
; zipper_vs_space: Scala zipper program materialization equals eager Space/Trie evaluation.
(rewrite (zipper_materialized "15-puzzle") (Result "5f7f76bc432e2f7a13fc479d"))
(rewrite (space_eval_trie "15-puzzle") (Result "5f7f76bc432e2f7a13fc479d"))
; graph_execT_vs_space: Scala operation graph execT output equals eager Space/Trie evaluation.
(rewrite (graph_execT "15-puzzle") (Result "5f7f76bc432e2f7a13fc479d"))
(run 10)

(check (= $trie_eval $reference_eval))

(check (= $source_optimized $source_original))

(check (= $zipper_materialized $space_eval_trie))

(check (= $graph_execT $space_eval_trie))

