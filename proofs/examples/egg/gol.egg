; Generated by morkl.CornerstoneProofArtifactMain
; Example: gol
; Pure Game-of-Life step using the MORKL neighbor and Range cardinality encoding.

(datatype Cert
  (trie_eval String)
  (reference_eval String)
  (source_optimized String)
  (source_original String)
  (zipper_materialized String)
  (space_eval_trie String)
  (graph_execT String)
  (Result String))

(let $trie_eval (trie_eval "gol"))
(let $reference_eval (reference_eval "gol"))
(let $source_optimized (source_optimized "gol"))
(let $source_original (source_original "gol"))
(let $zipper_materialized (zipper_materialized "gol"))
(let $space_eval_trie (space_eval_trie "gol"))
(let $graph_execT (graph_execT "gol"))

; trie_vs_reference: Trie evaluator output equals reference set evaluator output.
(rewrite (trie_eval "gol") (Result "f052ec939c6bc8b1f8659a33"))
(rewrite (reference_eval "gol") (Result "f052ec939c6bc8b1f8659a33"))

; space_optimized: Default source optimizer output equals original Space/term output.
(rewrite (source_optimized "gol") (Result "f052ec939c6bc8b1f8659a33"))
(rewrite (source_original "gol") (Result "f052ec939c6bc8b1f8659a33"))
; zipper_vs_space: Scala zipper program materialization equals eager Space/Trie evaluation.
(rewrite (zipper_materialized "gol") (Result "f052ec939c6bc8b1f8659a33"))
(rewrite (space_eval_trie "gol") (Result "f052ec939c6bc8b1f8659a33"))
; graph_execT_vs_space: Scala operation graph execT output equals eager Space/Trie evaluation.
(rewrite (graph_execT "gol") (Result "f052ec939c6bc8b1f8659a33"))
(run 10)

(check (= $trie_eval $reference_eval))

(check (= $source_optimized $source_original))

(check (= $zipper_materialized $space_eval_trie))

(check (= $graph_execT $space_eval_trie))

