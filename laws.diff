+    case Space.Raffination(Space.Subtraction(a, b), pr) => Space.Subtraction(Space.Raffination(a, pr), b)
+    case Space.Raffination(a, Space.Union(p1, p2)) => Space.Raffination(Space.Raffination(a, p1), p2)
