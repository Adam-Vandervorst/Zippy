; Schedules: whole-set equality (repeat N (run) (run acu) (saturate paths) (run neg));
;            ElemP membership   (repeat N (run) (saturate paths) (run neg)).

(datatype Path
  (Eps)
  (Item i64)
  (Concat Path Path))
(datatype Space
  (Empty)
  (Singleton Path)
  (Union Space Space)
  (Intersection Space Space)
  (Subtraction Space Space)
  (Restriction Space Space)
  (Wrap Path Space)
  (Unwrap Space Path)
  (Composition Space Space)
  (Head Space)
  (TailsUnion Space)
  (TailsIntersection Space)
  (Raffination Space Space)
  (IterC Space Space))
(relation drop-prefix (Path Path Space))
(relation tails-intersection (Space Space Space))
(relation tails-intersection-acc (Space Space Space Space))
(ruleset neg)
(ruleset paths)
(datatype EB (ET) (EF) (EOr EB EB) (EAnd EB EB) (EAndNot EB EB) (ElemP Path Space))
(rewrite (EOr (ET) b) (ET))
(rewrite (EOr b (ET)) (ET))
(rewrite (EOr (EF) b) b)
(rewrite (EOr b (EF)) b)
(rewrite (EAnd (EF) b) (EF))
(rewrite (EAnd b (EF)) (EF))
(rewrite (EAnd (ET) b) b)
(rewrite (EAnd b (ET)) b)
(rewrite (EAndNot a (ET)) (EF))
(rewrite (EAndNot a (EF)) a)
(rewrite (EAndNot (EF) b) (EF))
(rewrite (ElemP p (Empty)) (EF))
(rewrite (ElemP p (Singleton p)) (ET))
(rule ((= e (ElemP p (Singleton q))) (!= p q)) ((union e (EF))) :ruleset neg)
(rewrite (ElemP p (Union a b)) (EOr (ElemP p a) (ElemP p b)))
(rewrite (ElemP p (Intersection a b)) (EAnd (ElemP p a) (ElemP p b)))
(rewrite (ElemP p (Subtraction a b)) (EAndNot (ElemP p a) (ElemP p b)))
(rewrite (Union x x) x)
(rewrite (Intersection x x) x)
(rewrite (Subtraction x x) (Empty))
(ruleset acu)
(rewrite (Union x y) (Union y x) :ruleset acu)
(rewrite (Intersection x y) (Intersection y x) :ruleset acu)
(rewrite (Union x (Empty)) x)
(rewrite (Union (Empty) x) x)
(rewrite (Intersection x (Empty)) (Empty))
(rewrite (Intersection (Empty) x) (Empty))
(rewrite (Intersection (Union x y) z) (Union (Intersection x z) (Intersection y z)))
(rewrite (Intersection x (Union y z)) (Union (Intersection x y) (Intersection x z)))
(rewrite (Subtraction (Empty) x) (Empty))
(rewrite (Subtraction x (Empty)) x)
(rewrite (Subtraction (Union x y) z) (Union (Subtraction x z) (Subtraction y z)))
(rewrite (Subtraction x (Union y z)) (Subtraction (Subtraction x y) z))
(rewrite (Subtraction (Singleton p) (Singleton q)) (Singleton p) :when ((!= p q)) :ruleset neg)
(rewrite (Intersection (Singleton p) (Singleton q)) (Empty) :when ((!= p q)) :ruleset neg)
(rewrite (Concat x (Eps)) x :ruleset paths)
(rewrite (Concat (Eps) x) x :ruleset paths)
(rewrite (Concat (Concat x y) z) (Concat x (Concat y z)) :ruleset paths)
(rewrite (Wrap x (Empty)) (Empty))
(rewrite (Wrap (Eps) s) s)
(rewrite (Wrap x (Singleton p)) (Singleton (Concat x p)))
(rewrite (Wrap x (Union s t)) (Union (Wrap x s) (Wrap x t)))
(rewrite (Unwrap (Empty) p) (Empty))
(rewrite (Unwrap s (Eps)) s)
(rewrite (Unwrap (Wrap p s) p) s)
(rewrite (Unwrap (Wrap (Concat p q) s) p) (Wrap q s))
(rewrite (Unwrap (Wrap p s) (Concat p q)) (Unwrap s q))
(rewrite (Unwrap (Union s t) x) (Union (Unwrap s x) (Unwrap t x)))
(rule ((= out (Unwrap (Singleton whole) prefix)))   
      ((drop-prefix prefix whole out)))
(rule ((drop-prefix (Eps) whole out))   
      ((union out (Singleton whole))))
(rule ((drop-prefix p p out))   
      ((union out (Singleton (Eps)))))
(rule ((drop-prefix p (Concat p rest) out))   
      ((union out (Singleton rest))))
(rule ((drop-prefix (Concat p q) (Concat p r) out))   
      ((drop-prefix q r out)))
(rule ((drop-prefix (Item a) (Eps) out))   
      ((union out (Empty))))
(rule ((drop-prefix (Concat (Item a) p) (Eps) out))   
      ((union out (Empty))))
(rule ((drop-prefix (Item a) (Item b) out) (!= a b))   
      ((union out (Empty))))
(rule ((drop-prefix (Item a) (Concat (Item b) r) out) (!= a b))   
      ((union out (Empty))))
(rule ((drop-prefix (Concat (Item a) p) (Item b) out) (!= a b))   
      ((union out (Empty))))
(rule ((drop-prefix (Concat (Item a) p) (Concat (Item b) r) out) (!= a b))   
      ((union out (Empty))))
(rewrite (Composition (Empty) t) (Empty))
(rewrite (Composition s (Empty)) (Empty))
(rewrite (Composition (Union s t) u) (Union (Composition s u) (Composition t u)))
(rewrite (Composition s (Union t u)) (Union (Composition s t) (Composition s u)))
(rewrite (Composition (Union (Singleton p) s) t) (Union (Wrap p t) (Composition s t)))
(rewrite (Composition (Singleton p) t) (Wrap p t))
(rewrite (TailsUnion (Empty)) (Empty))
(rewrite (TailsUnion (Singleton (Eps))) (Empty))
(rewrite (TailsUnion (Singleton (Item h))) (Singleton (Eps)))
(rewrite (TailsUnion (Singleton (Concat (Item h) t))) (Singleton t))
(rewrite (TailsUnion (Union s t)) (Union (TailsUnion s) (TailsUnion t)))
(rewrite (TailsUnion (Union (Wrap (Item p) s) t)) (Union s (TailsUnion t)))
(rewrite (TailsUnion (Wrap (Item p) s)) s)
(rule ((= out (TailsIntersection x)))   
      ((tails-intersection (Head x) x out)))
(rule ((tails-intersection (Empty) x out))   
      ((union out (Empty))))
(rule ((tails-intersection (Singleton h) x out))   
      ((union out (Unwrap x h))))
(rule ((tails-intersection (Union (Singleton h) rest) x out))   
      ((tails-intersection-acc rest x (Unwrap x h) out)))
(rule ((tails-intersection-acc (Singleton h) x acc out))   
      ((union out (Intersection acc (Unwrap x h)))))
(rule ((tails-intersection-acc (Union (Singleton h) rest) x acc out))   
      ((tails-intersection-acc rest x (Intersection acc (Unwrap x h)) out)))
(rewrite (Restriction (Empty) p) (Empty))
(rewrite (Restriction x (Empty)) (Empty))
(rewrite (Restriction x (Singleton (Eps))) x)
(rewrite (Restriction x (Union p q)) (Union (Restriction x p) (Restriction x q)))
(rewrite (Restriction x (Singleton p)) (Wrap p (Unwrap x p)))
(rewrite (Head (Empty)) (Empty))
(rewrite (Head (Singleton (Eps))) (Empty))
(rewrite (Head (Union x y)) (Union (Head x) (Head y)))
(rewrite (Head (Singleton (Concat (Item h) t))) (Singleton (Item h)))
(rewrite (Head (Singleton (Item h))) (Singleton (Item h)))
(rewrite (Restriction x x) x)
(rewrite (Raffination x y) (Subtraction x (Restriction x y)))
(rewrite (Unwrap (Unwrap s p) q) (Unwrap s (Concat p q)))
(rewrite (Unwrap (Wrap (Item p) s) (Item q)) (Empty) :when ((!= p q)))
(rewrite (IterC (Empty) b) (Empty))
(rewrite (IterC (Singleton (Eps)) b) (Empty))
(rewrite (IterC (Singleton (Item h)) b) b)
(rewrite (IterC (Singleton (Concat (Item h) t)) b) b)
(rewrite (IterC (Union s t) b) (Union (IterC s b) (IterC t b)))
