  (RangeDropLastOp
    (TrieZ
      (Union
        (Singleton (Item left))
        (Singleton (Item right)))))
  (TrieZ (Singleton (Item left)))
  :when ((ordered-before left right)))
(rewrite
  (RangeDropLastOp
    (TrieZ
      (Union
        (Singleton (Item left))
        (Singleton (Item right)))))
  (TrieZ (Singleton (Item right)))
