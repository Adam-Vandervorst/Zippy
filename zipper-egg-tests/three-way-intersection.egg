; AUTO-GENERATED — three-way A∩B∩C over small literals — nested virtual Intersection cursors
; Coincidence is checked PURELY BY MOVEMENT — the result trie is NEVER materialised here.
; A CURSOR (Root $prog) is moved by Descend: for every member the focus is a member
; (TermAt = T); for every boundary non-member it is not (TermAt = F); an absent key's focus
; is the empty subspace.  Ascend inverts Descend (the zipper contract), checked per file.
; For virtual cursors the Sub rules move LOCALLY through the operators — no operand is built.

(include "prelude.egg")
(let $prog (Intersection (Intersection (Union (Union (Wrap1 166 (Eps)) (Wrap1 167 (Eps))) (Wrap1 169 (Eps))) (Union (Union (Wrap1 167 (Eps)) (Wrap1 168 (Eps))) (Wrap1 169 (Eps)))) (Union (Union (Wrap1 163 (Eps)) (Wrap1 167 (Eps))) (Wrap1 169 (Eps)))))
(let $root (TermAt (Root $prog)))
(let $mem0 (TermAt (Descend 167 (Root $prog))))
(let $mem1 (TermAt (Descend 169 (Root $prog))))
(let $non0 (TermAt (Descend 163 (Root $prog))))
(let $non1 (TermAt (Descend 166 (Root $prog))))
(let $non2 (TermAt (Descend 168 (Root $prog))))
(let $non3 (TermAt (Descend 163 (Descend 167 (Root $prog)))))
(let $non4 (TermAt (Descend 166 (Descend 167 (Root $prog)))))
(let $non5 (TermAt (Descend 167 (Descend 167 (Root $prog)))))
(let $non6 (TermAt (Descend 168 (Descend 167 (Root $prog)))))
(let $non7 (TermAt (Descend 169 (Descend 167 (Root $prog)))))
(let $non8 (TermAt (Descend 163 (Descend 169 (Root $prog)))))
(let $non9 (TermAt (Descend 166 (Descend 169 (Root $prog)))))
(let $non10 (TermAt (Descend 167 (Descend 169 (Root $prog)))))
(let $non11 (TermAt (Descend 168 (Descend 169 (Root $prog)))))
(let $non12 (TermAt (Descend 169 (Descend 169 (Root $prog)))))
(let $absent (IsEmpty (FocusOf (Descend 999998 (Root $prog)))))
(let $zipup (FocusOf (Ascend (Descend 167 (Root $prog)))))

(run 300)

; ε is NOT a member
(check (= $root (F)))
; 2 member path(s): each reachable by movement (focus TermAt = T)
(check (= $mem0 (T)))
(check (= $mem1 (T)))
; 13 boundary non-member(s): each UNreachable (focus TermAt = F)
(check (= $non0 (F)))
(check (= $non1 (F)))
(check (= $non2 (F)))
(check (= $non3 (F)))
(check (= $non4 (F)))
(check (= $non5 (F)))
(check (= $non6 (F)))
(check (= $non7 (F)))
(check (= $non8 (F)))
(check (= $non9 (F)))
(check (= $non10 (F)))
(check (= $non11 (F)))
(check (= $non12 (F)))
(check (= $absent (T)))
(check (= $zipup $prog))
