; ================================================================================================
; The IMPLEMENTATION of the zipper / trie operations modelled in egglog — the actual SET OPERATIONS
; and RECURSION that `src/main/scala/IntTrie.scala` (ITrie.union/intersection/…) and
; `SpaceZipper.materialize` run, NOT just their resulting trie.
;
; A trie is `(Node terminal children)` with `children` a key-ASCENDING list (`CC key subtrie rest` /
; `CNil`) holding no empty subtrie — exactly the `(terminal, IntMap[ITrie])` ITrie shape, with the
; IntMap rendered as the sorted assoc-list its Patricia merges walk.  Each operation is a constructor
; that REDUCES by the same simultaneous-descent recursion as the Scala code:
;   union          : merge both child lists; recurse on shared keys                (ITrie.union / IntTrieOps.unionTries)
;   intersection   : keep shared keys, recurse, PRUNE empties                      (… intersectTries, with `keep`)
;   subtraction    : keep a's keys; at shared keys subtract & prune                (… diffTries)
;   composition    : graft b at every terminal of a (map children, splice b if a∋ε)(ITrie.composition)
;   restriction    : descend keys common to x and the (non-terminal) prefixes      (ITrie.restriction / restrictTries)
;   raffination    : x \ (x <| y)                                                  (ITrie.raffination)
;   wrap / unwrap  : prepend one item / look one item up                           (ITrie.wrap / unwrap)
;   tails-union/∩  : ∪ / ∩ of the child subtries                                   (ITrie.tailsUnion / tailsIntersection)
; `Mat` is `SpaceZipper.materialize`: it dispatches each virtual cursor to the matching trie op.
;
; Coincidence: every op reduces a transpiled input to the SAME canonical `Node` the Scala op returns
; (checked below and, per program, under `zipper-egg-tests/*-impl.egg`); and the algebraic laws of the
; IMPLEMENTATION (idempotence, commutativity, associativity, distributivity, De Morgan, …) are proved
; by reducing both sides to one canonical normal form.  egglog exits 0 with every (check) passing.
; ================================================================================================

(datatype*
  (B (T) (F) (Or B B) (And B B) (AndNot B B))
  (Tr (Node B CL)                       ; a trie node: terminal? + sorted child list
      (TrU Tr Tr) (TrI Tr Tr) (TrS Tr Tr) (TrC Tr Tr)      ; union / intersect / subtract / compose
      (TrR Tr Tr) (TrRaf Tr Tr)                            ; restriction / raffination
      (TrW i64 Tr) (TrUn i64 Tr)                           ; wrap one item / unwrap one item
      (TrTU Tr) (TrTI Tr)                                  ; tails-union / tails-intersection
      (TrH Tr)                                             ; head: the present first items, as {h}
      (ClTU CL) (ClTI CL)                                  ; ∪ / ∩ over a child list (yields a Tr)
      (ZLit Tr) (Mat Tr))                                  ; a concrete cursor / materialise a (virtual) cursor
  (CL (CNil) (CC i64 Tr CL)             ; key-ascending child list (no empty subtrie)
      (ClU CL CL) (ClI CL CL) (ClS CL CL) (ClR CL CL) (ClMapC CL Tr)
      (HCl CL)                                             ; head over a child list
      (ConsIf i64 Tr CL)))                                 ; cons that drops an empty subtrie

; ---- booleans (the terminal flag algebra) ----
(rewrite (Or  (T) b) (T)) (rewrite (Or  b (T)) (T)) (rewrite (Or  (F) b) b) (rewrite (Or  b (F)) b)
(rewrite (And (F) b) (F)) (rewrite (And b (F)) (F)) (rewrite (And (T) b) b) (rewrite (And b (T)) b)
(rewrite (AndNot a (T)) (F)) (rewrite (AndNot a (F)) a)

; ---- ConsIf k v rest : prepend (k,v) unless v is the empty trie (mirrors `keep`/`binPrune`) ----
(rewrite (ConsIf k (Node (F) (CNil)) rest) rest)
(rewrite (ConsIf k (Node (T) c) rest) (CC k (Node (T) c) rest))
(rewrite (ConsIf k (Node (F) (CC j w cr)) rest) (CC k (Node (F) (CC j w cr)) rest))

; ---- UNION : (or terminals, merge child lists; recurse on shared keys) ----
(rewrite (TrU (Node t1 c1) (Node t2 c2)) (Node (Or t1 t2) (ClU c1 c2)))
(rewrite (ClU (CNil) c) c) (rewrite (ClU c (CNil)) c)
(rule ((= e (ClU (CC k1 v1 r1) (CC k2 v2 r2))) (< k1 k2)) ((union e (CC k1 v1 (ClU r1 (CC k2 v2 r2))))))
(rule ((= e (ClU (CC k1 v1 r1) (CC k2 v2 r2))) (< k2 k1)) ((union e (CC k2 v2 (ClU (CC k1 v1 r1) r2)))))
(rule ((= e (ClU (CC k1 v1 r1) (CC k2 v2 r2))) (= k1 k2)) ((union e (CC k1 (TrU v1 v2) (ClU r1 r2)))))

; ---- INTERSECTION : (and terminals; only shared keys, recursed, empties pruned) ----
(rewrite (TrI (Node t1 c1) (Node t2 c2)) (Node (And t1 t2) (ClI c1 c2)))
(rewrite (ClI (CNil) c) (CNil)) (rewrite (ClI c (CNil)) (CNil))
(rule ((= e (ClI (CC k1 v1 r1) (CC k2 v2 r2))) (< k1 k2)) ((union e (ClI r1 (CC k2 v2 r2)))))
(rule ((= e (ClI (CC k1 v1 r1) (CC k2 v2 r2))) (< k2 k1)) ((union e (ClI (CC k1 v1 r1) r2))))
(rule ((= e (ClI (CC k1 v1 r1) (CC k2 v2 r2))) (= k1 k2)) ((union e (ConsIf k1 (TrI v1 v2) (ClI r1 r2)))))

; ---- SUBTRACTION : (a∧¬b terminals; keep a's keys, at shared keys subtract & prune) ----
(rewrite (TrS (Node t1 c1) (Node t2 c2)) (Node (AndNot t1 t2) (ClS c1 c2)))
(rewrite (ClS (CNil) c) (CNil)) (rewrite (ClS c (CNil)) c)
(rule ((= e (ClS (CC k1 v1 r1) (CC k2 v2 r2))) (< k1 k2)) ((union e (CC k1 v1 (ClS r1 (CC k2 v2 r2))))))
(rule ((= e (ClS (CC k1 v1 r1) (CC k2 v2 r2))) (< k2 k1)) ((union e (ClS (CC k1 v1 r1) r2))))
(rule ((= e (ClS (CC k1 v1 r1) (CC k2 v2 r2))) (= k1 k2)) ((union e (ConsIf k1 (TrS v1 v2) (ClS r1 r2)))))

; ---- COMPOSITION : graft b at every terminal of a ----
(rewrite (TrC (Node (F) c1) b) (Node (F) (ClMapC c1 b)))               ; a∌ε : just compose each child with b
(rewrite (TrC (Node (T) c1) b) (TrU (Node (F) (ClMapC c1 b)) b))       ; a∋ε : also splice b here
(rewrite (ClMapC (CNil) b) (CNil))
(rewrite (ClMapC (CC k v r) b) (ConsIf k (TrC v b) (ClMapC r b)))

; ---- RESTRICTION : keep x-paths having a prefix in `prefixes` ----
(rewrite (TrR x (Node (T) cp)) x)                                      ; a prefix ended here ⇒ keep all of x
(rewrite (TrR (Node tx cx) (Node (F) cp)) (Node (F) (ClR cx cp)))      ; else descend common keys
(rewrite (ClR (CNil) cp) (CNil)) (rewrite (ClR cx (CNil)) (CNil))
(rule ((= e (ClR (CC k1 v1 r1) (CC k2 v2 r2))) (< k1 k2)) ((union e (ClR r1 (CC k2 v2 r2)))))
(rule ((= e (ClR (CC k1 v1 r1) (CC k2 v2 r2))) (< k2 k1)) ((union e (ClR (CC k1 v1 r1) r2))))
(rule ((= e (ClR (CC k1 v1 r1) (CC k2 v2 r2))) (= k1 k2)) ((union e (ConsIf k1 (TrR v1 v2) (ClR r1 r2)))))

; ---- RAFFINATION : x \| y = x \ (x <| y) ----
(rewrite (TrRaf x y) (TrS x (TrR x y)))

; ---- WRAP one item / UNWRAP one item ----
(rewrite (TrW k z) (Node (F) (ConsIf k z (CNil))))                     ; prepend k (drops if z empty)
(rewrite (TrUn k (Node t (CNil))) (Node (F) (CNil)))                   ; nothing under k
(rule ((= e (TrUn k (Node t (CC j v r)))) (= k j)) ((union e v)))
(rule ((= e (TrUn k (Node t (CC j v r)))) (< k j)) ((union e (Node (F) (CNil)))))   ; sorted ⇒ k not present
(rule ((= e (TrUn k (Node t (CC j v r)))) (< j k)) ((union e (TrUn k (Node t r)))))

; ---- TAILS-UNION / TAILS-INTERSECTION : ∪ / ∩ of the child subtries ----
(rewrite (TrTU (Node t c)) (ClTU c))
(rewrite (ClTU (CNil)) (Node (F) (CNil)))
(rewrite (ClTU (CC k v r)) (TrU v (ClTU r)))
(rewrite (TrTI (Node t c)) (ClTI c))
(rewrite (ClTI (CNil)) (Node (F) (CNil)))
(rewrite (ClTI (CC k v (CNil))) v)
(rewrite (ClTI (CC k v (CC j w r))) (TrI v (ClTI (CC j w r))))

; ---- HEAD : the present first items, each as a length-1 path (ITrie.head) ----
(rewrite (TrH (Node t c)) (Node (F) (HCl c)))
(rewrite (HCl (CNil)) (CNil))
(rewrite (HCl (CC k v r)) (CC k (Node (T) (CNil)) (HCl r)))

; ---- MATERIALISE a (virtual) cursor : dispatch each operator to its trie op (SpaceZipper.materialize) ----
(rewrite (Mat (ZLit t)) t)
(rewrite (Mat (TrU a b)) (TrU (Mat a) (Mat b)))
(rewrite (Mat (TrI a b)) (TrI (Mat a) (Mat b)))
(rewrite (Mat (TrS a b)) (TrS (Mat a) (Mat b)))
(rewrite (Mat (TrC a b)) (TrC (Mat a) (Mat b)))
(rewrite (Mat (TrR x p)) (TrR (Mat x) (Mat p)))
(rewrite (Mat (TrRaf x y)) (TrRaf (Mat x) (Mat y)))
(rewrite (Mat (TrW k z)) (TrW k (Mat z)))
(rewrite (Mat (TrUn k z)) (TrUn k (Mat z)))              ; was MISSING (probe: Mat of an unwrap cursor)
(rewrite (Mat (TrTU z)) (TrTU (Mat z)))
(rewrite (Mat (TrTI z)) (TrTI (Mat z)))
(rewrite (Mat (TrH z)) (TrH (Mat z)))

; ================================================================================================
